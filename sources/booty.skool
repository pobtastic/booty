 $F7F9 LD B,$FF      ; #REGb=#N$FF (noise pitch).
 $F7FB LD DE,$0014   ; #REGde=#N($0014,$04,$04) (duration).
; #HTML(#AUDIO0(bomb.wav)(#INCLUDE(Bomb)))
 $F7FE CALL $F618    ; Play white noise for the sparks.
 $F801 POP HL        ; {Restore #REGhl, #REGde, #REGbc, #REGaf and #REGaf from
 $F802 POP DE        ; the stack.
 $F803 POP BC        ;
 $F804 POP AF        ;
 $F805 POP AF        ; }
 $F806 CALL $0038    ; Call #SKOOLKID$0038(MASK_INT).
