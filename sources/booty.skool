; Initialise Game
;
; Used by the routines at #R$D08A and #R$D602.
;
; .
;
; Don't reset player lives or booty count if the game has already been
; completed and has looped around to start again.
@label=InitialiseGame
c$DEA8 LD A,($5BF0)  ; {Jump to #R$DEBC if *#R$5BF0 is set to "Game Looped
 $DEAB CP $02        ; Mode" (#N$02).
 $DEAD JP Z,$DEBC    ; }
; Initialise new Game State attributes.
 $DEB0 LD A,$03      ; {Write #N$03 to *#R$5BF1.
 $DEB2 LD ($5BF1),A  ; }
 $DEB5 LD BC,$0000   ; {Write #N($0000,$04,$04) to *#R$5BF4.
 $DEB8 LD ($5BF4),BC ; }
; This entry point is used by the routine at #R$DFD3.
@label=InitialiseGameStates
*$DEBC XOR A         ; {Write #N$00 to *#R$5BD3.
 $DEBD LD ($5BD3),A  ; }
 $DEC0 LD BC,$007D   ; {Write #N($007D,$04,$04) to *#R$5BF2.
 $DEC3 LD ($5BF2),BC ; }
 $DEC7 JR $DECE      ; Jump to #R$DECE.
; This entry point is used by the routine at #R$E3A4.
@label=SetFirstRoom
*$DEC9 LD A,$01      ; {Write #N$01 to *#R$5BD3.
 $DECB LD ($5BD3),A  ; }
; Initialise Player starting attributes.
@label=InitialisePlayer
*$DECE LD DE,$F231   ; {Copy #N($0014,$04,$04) bytes of data from #R$F245 to
 $DED1 LD HL,$F245   ; #R$F231.
 $DED4 LD BC,$0014   ;
 $DED7 LDIR          ; }
 $DED9 LD A,$00      ; {Write #N$00 to: #LIST { *#R$F33A } { *#R$F33F } {
 $DEDB LD ($F33A),A  ; *#R$E479 } LIST#
 $DEDE LD ($F33F),A  ;
 $DEE1 LD ($E479),A  ; }
 $DEE4 LD A,$00      ; {Write #N$00 to *#R$F2DB.
 $DEE6 LD ($F2DB),A  ; }
 $DEE9 LD A,$00      ; {Write #N$00 to: #LIST
 $DEEB LD ($F31C),A  ; { *#R$F31C }
 $DEEE LD ($5C78),A  ; { *#SKOOLKID$5C78(FRAMES) }
 $DEF1 LD ($5C79),A  ; { *#SKOOLKID$5C78(FRAMES+#N$01) }
 $DEF4 LD ($F340),A  ; { *#R$F340 }
                     ; LIST#}
; This also draws the whole room.
 $DEF7 CALL $E0A9    ; Call #R$E0A9.
; Restore the default ZX Spectrum font.
 $DEFA LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $DEFD LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
 $DF00 LD A,$10      ; {Set INK: YELLOW (#N$06).
 $DF02 RST $10       ;
 $DF03 LD A,$06      ;
 $DF05 RST $10       ; }
 $DF06 LD A,$11      ; {Set PAPER: *#R$5BD0.
 $DF08 RST $10       ;
 $DF09 LD A,($5BD0)  ;
 $DF0C RST $10       ; }
 $DF0D CALL $E064    ; Call #R$E064.
 $DF10 CALL $E058    ; Call #R$E058.
; This is the beginning of the game loop.
@label=Game_Loop
*$DF13 LD A,$11      ; {Set PAPER: *#R$5BD1.
 $DF15 RST $10       ;
 $DF16 LD A,($5BD1)  ;
 $DF19 RST $10       ; }
 $DF1A CALL $E22D    ; Call #R$E22D.
 $DF1D CALL $F1FC    ; Call #R$F1FC.
 $DF20 CALL $E47A    ; Call #R$E47A.
 $DF23 CALL $E3E0    ; Call #R$E3E0.
 $DF26 CALL $F001    ; Call #R$F001.
 $DF29 CALL $E9D9    ; Call #R$E9D9.
 $DF2C CALL $E821    ; Call #R$E821.
; The player doesn't display during the demo mode, he can still "die"
; though - hence how often you hear the "lose a life" sound.
 $DF2F LD A,($5BF0)  ; {Call #R$EBD8 if *#R$5BF0 is not set to "Demo Mode"
 $DF32 CP $03        ; (#N$03).
 $DF34 CALL NZ,$EBD8 ; }
 $DF37 CALL $E4F1    ; Call #R$E4F1.
 $DF3A LD A,($E820)  ; {Jump to #R$DF45 if *#R$E820 is equal to #N$00.
 $DF3D CP $00        ;
 $DF3F JR Z,$DF45    ; }
 $DF41 DEC A         ; Decrease #REGa by one.
 $DF42 LD ($E820),A  ; Write #REGa to *#R$E820.
*$DF45 LD A,($5BEA)  ; {Call #R$E30B if *#R$5BEA is set to Kempston joystick
 $DF48 CP $0C        ; (#N$0C).
 $DF4A CALL Z,$E30B  ; }
 $DF4D LD A,($5BEA)  ; {Call #R$ED35 if *#R$5BEA is not set to Kempston
 $DF50 CP $0C        ; joystick (#N$0C).
 $DF52 CALL NZ,$ED35 ; }
 $DF55 CALL $E5F4    ; Call #R$E5F4.
 $DF58 CALL $E581    ; Call #R$E581.
; Display the currently carried key.
; .
; Set attributes.
 $DF5B LD A,$10      ; {Set INK: YELLOW (#N$06).
 $DF5D RST $10       ;
 $DF5E LD A,$06      ;
 $DF60 RST $10       ; }
 $DF61 LD A,$11      ; {Set PAPER: *#R$5BD0.
 $DF63 RST $10       ;
 $DF64 LD A,($5BD0)  ;
 $DF67 RST $10       ; }
 $DF68 LD C,$1B      ; {Set up the screen buffer location #N$1B/#N$01 using
 $DF6A LD B,$01      ; #SKOOLKID$0DD9(CL_SET).
 $DF6C CALL $0DD9    ; }
; Restore the default ZX Spectrum font.
 $DF6F LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $DF72 LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
 $DF75 LD IX,$F231   ; #REGix=#R$F231.
 $DF79 LD A,(IX+$10) ; #REGa=*#REGix+#N$10.
 $DF7C ADD A,$30     ; #REGa+=#N$30.
 $DF7E CALL $E6DC    ; Call #R$E6DC.
 $DF81 LD BC,($5BF2) ; #REGbc=*#R$5BF2.
 $DF85 LD A,C        ; {Call #R$DFD3 if #REGbc is zero.
 $DF86 OR B          ;
 $DF87 CALL Z,$DFD3  ; }
 $DF8A LD A,($5BF0)  ; {Jump to #R$DF13 if *#R$5BF0 is not set to "Demo Mode"
 $DF8D CP $03        ; (#N$03).
 $DF8F JP NZ,$DF13   ; }
; Else, this is the demo mode - so check the timer.
 $DF92 LD A,($5C79)  ; {Loop back round to #R$DF13 until
 $DF95 CP $03        ; *#SKOOLKID$5C78(FRAMES+#N$01) is equal to #N$03.
 $DF97 JP NZ,$DF13   ; }
 $DF9A LD A,($F340)  ; {Increment *#R$F340 by one.
 $DF9D INC A         ;
 $DF9E LD ($F340),A  ; }
 $DFA1 CP $02        ; {Call #R$ED8F if *#R$F340 is equal to #N$02.
 $DFA3 CALL Z,$ED8F  ; }
 $DFA6 CALL $E349    ; {Get a random room number between #N$02 and #N$11.
 $DFA9 AND %00001111 ;
 $DFAB ADD A,$02     ; }
 $DFAD CALL $EE84    ; Call #R$EE84.
; Reset the *#SKOOLKID$5C78(FRAMES) counter back to #N($0000,$04,$04).
 $DFB0 LD A,$00      ; {Write #N$00 to: #LIST
 $DFB2 LD ($5C78),A  ; { *#SKOOLKID$5C78(FRAMES) }
 $DFB5 LD ($5C79),A  ; { *#SKOOLKID$5C78(FRAMES+#N$01) }
                     ; LIST#}
 $DFB8 JP $DF13      ; Jump to #R$DF13.

; Graphics: Golden Key
@label=Graphics_GoldenKey
b$DFBB DEFB $7E,$FF,$C3,$C3,$FF,$7E,$18,$18 ; {#UDGTABLE {
 $DFC3 DEFB $18,$18,$18,$1F,$1E,$1F,$1E,$1F ; #UDGS$01,$02,$04(golden-key)(#UDG(#PC+$08*$y,attr=$06)(*golden-key)golden-key)
                                            ; } UDGTABLE#}

; Force Game-Over
;
; Used by the routine at #R$DFD3.
@label=ForceGameOver
c$DFCB LD A,$00      ; {Write #N$00 to #R$5BF1.
 $DFCD LD ($5BF1),A  ; }
 $DFD0 JP $E3A4      ; Jump to #R$E3A4.

; All Treasure Collected
;
; Used by the routine at #R$DEA8.
;
; .
;
; Restore the default ZX Spectrum font.
@label=AllTreasureCollected
c$DFD3 LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $DFD6 LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
; Set the attributes.
 $DFD9 LD A,$10      ; {Set INK: WHITE (#N$07).
 $DFDB RST $10       ;
 $DFDC LD A,$07      ;
 $DFDE RST $10       ; }
 $DFDF LD A,$11      ; {Set PAPER: *#R$5BD1.
 $DFE1 RST $10       ;
 $DFE2 LD A,($5BD1)  ;
 $DFE5 RST $10       ; }
; Don't decrease *#R$5BFF every frame, we track a count of the frames and only
; decrease it every 20th frame.
 $DFE6 LD BC,($5BFA) ; {Decrease *#R$5BFA by one.
 $DFEA DEC BC        ;
 $DFEB LD ($5BFA),BC ; }
 $DFEF LD A,B        ; {Skip to #R$E004 if *#R$5BFA is not yet zero.
 $DFF0 OR C          ;
 $DFF1 JR NZ,$E004   ; }
; #N$14 frames have passed, so decrease the actual timer and check that it
; hasn't expired yet.
 $DFF3 LD BC,$0014   ; {Reset *#R$5BFA back to #N($0014,$04,$04).
 $DFF6 LD ($5BFA),BC ; }
 $DFFA LD A,($5BFF)  ; {Decrease *#R$5BFF by one.
 $DFFD DEC A         ;
 $DFFE LD ($5BFF),A  ; }
; Player lives don't matter with the Golden Key section of the game, once the
; timer expires it's Game Over.
 $E001 JP Z,$DFCB    ; Jump to #R$DFCB if *#R$5BFF is zero.
; Display the Golden Key timer.
@label=DisplayGoldenKeyTimer
*$E004 LD C,$0C      ; {Set up the screen buffer location #N$0C/#N$02 using
 $E006 LD B,$02      ; #SKOOLKID$0DD9(CL_SET).
 $E008 CALL $0DD9    ; }
; Store *#R$5BFF in #REGbc so we can use #SKOOLKID$1A1B(OUT_NUM_1) to print it
; to the screen.
 $E00B LD B,$00      ; {#REGbc=*#R$5BFF.
 $E00D LD A,($5BFF)  ;
 $E010 LD C,A        ; }
 $E011 CALL $1A1B    ; Call #SKOOLKID$1A1B(OUT_NUM_1).
; The ASCII space after the timer acts to clear "extra" digits when the timer
; transitions to being single digit.
 $E014 LD A,$20      ; #REGa=ASCII "space" (#N$20).
 $E016 CALL $E6DC    ; Call #R$E6DC.
; Is the Golden Key in the current room?
 $E019 LD A,($5BD3)  ; {Return if *#R$5BD3 is not equal to *#R$5BFC.
 $E01C LD HL,$5BFC   ;
 $E01F CP (HL)       ;
 $E020 RET NZ        ; }
; It is in this room, so display it.
 $E021 LD BC,($5BFD) ; #REGbc=*#R$5BFD.
 $E025 LD HL,$DEBB   ; {Write #R$DFBB(#N$DEBB) to *#SKOOLKID$5C36(CHARS).
 $E028 LD ($5C36),HL ; }
 $E02B LD A,$10      ; {Set INK: YELLOW (#N$06).
 $E02D RST $10       ;
 $E02E LD A,$06      ;
 $E030 RST $10       ; }
 $E031 LD A,$20      ; #REGa=#N$20 (base sprite ID).
 $E033 LD DE,$0201   ; #REGde=Set the sprite width/ height (#N$02/ #N$01).
 $E036 CALL $EA93    ; Call #R$EA93.
; Handle player collision with the Golden Key.
 $E039 LD IX,$F231   ; #REGix=#R$F231.
 $E03D LD BC,($5BFD) ; #REGbc=*#R$5BFD.
 $E041 LD A,(IX+$00) ; {Return if the players horizontal co-ordinate is not
 $E044 CP C          ; equal to the Golden Key horizontal co-ordinate.
 $E045 RET NZ        ; }
 $E046 LD A,(IX+$01) ; {Return if the players vertical co-ordinate is not equal
 $E049 CP B          ; to the Golden Key vertical co-ordinate.
 $E04A RET NZ        ; }
; The player has collected the Golden Key!
; .
; Hilariously, just beep at the player and restart the game. Zero fanfare!
; .
; #HTML(#AUDIO0(collected-golden-key.wav)(#INCLUDE(CollectedGoldenKey)))
 $E04B LD DE,$00C8   ; #REGde=#N($00C8,$04,$04).
 $E04E LD HL,$00C8   ; #REGhl=#N($00C8,$04,$04).
 $E051 CALL $03B5    ; Call #SKOOLKID$03B5(BEEPER).
 $E054 POP BC        ; Restore #REGbc from the stack.
 $E055 JP $DEBC      ; Jump to #R$DEBC.

; Reset Sound Flags
;
; Used by the routines at #R$DEA8, #R$ED8F and #R$EE5B.
;
; .
;
; #HTML(<p>It's quite difficult to find much technical information on how the
; <a rel="noopener nofollow" href="https://en.wikipedia.org/wiki/Currah">Currah μSpeech</a> ("Microspeech")
; works.
; The <a rel="noopener nofollow" href="https://speccy4ever.speccy.org/doc/uSpeech.pdf">manual</a>
; (section 6) does delve into it on a functional level, and
; <a rel="noopener nofollow" href="https://k1.spdns.de/Vintage/Sinclair/82/Peripherals/Currah%20uSpeech/">this link</a>
; is an excellent write-up of memory addresses where the device functions from.</p>
; <p>Why this is relevant is because;
; the <a rel="noopener nofollow" href="https://spectrumcomputing.co.uk/forums/viewtopic.php?p=123353#p123353">Spectrum Computing</a> forums
; have cleverly found out that the Goldfish minigame is probably activated via this routine.</p>)
@label=ResetSoundFlags
c$E058 LD HL,$A06C   ; #REGhl=#R$A06C.
 $E05B LD DE,$FFFB   ; #REGde=#R$FFFB.
 $E05E LD BC,$0064   ; #REGbc=#N($0064,$04,$04).
; #HTML(<strong>Note;</strong> obviously doing this crosses over the
; #N$FFFF boundary. On a "normal" Spectrum the ROM is not writable at all
; (hence ROM, it's Read-Only Memory), however with a Currah μSpeech unit
; attached, #N($0000,$04,$04) is part of the device RAM - and hence <em>is then
; writable</em> (and will write #N$00 up to #N($005F,$04,$04)).)
 $E061 LDIR          ; Copy #N($0064,$04,$04) bytes of data from *#R$A06C to
                     ; *#R$FFFB.
 $E063 RET           ; Return.
; As for the "why does this activate the minigame?" that is still
; somewhat still waiting to be discovered.

; Print Status Bar Icons
;
; Used by the routines at #R$DEA8 and #R$E0A9.
@label=PrintStatusBarIcons
c$E064 LD HL,$F15B   ; {Write #R$F25B(#N$F15B) to *#SKOOLKID$5C36(CHARS).
 $E067 LD ($5C36),HL ; }
; Set up the screen buffer position.
 $E06A LD C,$21      ; {Set up the screen buffer location #N$01/#N$21 using
 $E06C LD B,$01      ; #SKOOLKID$0DD9(CL_SET).
 $E06E CALL $0DD9    ; }
; Skip showing any lives if the player is using their last life.
 $E071 LD A,($5BF1)  ; {Jump to #R$E080 if *#R$5BF1 is equal to #N$00.
 $E074 CP $00        ;
 $E076 JR Z,$E080    ; }
; Display a life icon for each life the player has.
; .
; #HTML(<img alt="life" src="../images/udgs/life.png">)
 $E078 LD B,A        ; #REGb=#R$5BF1 (number of lives counter).
@label=PrintLifeIcon_Loop
*$E079 LD A,$21      ; #REGa=Player life icon (#N$21).
 $E07B CALL $E6DC    ; Call #R$E6DC.
 $E07E DJNZ $E079    ; Decrease lives counter by one and loop back to #R$E079
                     ; until all lives have been printed.
; Put a space between the lives and the key icon.
; .
; Restore the default ZX Spectrum font.
@label=PrintKeyIcon
*$E080 LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $E083 LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
 $E086 LD A,$20      ; #REGa=ASCII "space" (#N$20).
 $E088 CALL $E6DC    ; Call #R$E6DC.
; Set up the screen buffer position.
 $E08B LD C,$1D      ; {Set up the screen buffer location #N$01/#N$1D using
 $E08D LD B,$01      ; #SKOOLKID$0DD9(CL_SET).
 $E08F CALL $0DD9    ; }
 $E092 LD HL,$F15B   ; {Write #R$F25B(#N$F15B) to *#SKOOLKID$5C36(CHARS).
 $E095 LD ($5C36),HL ; }
; Display the key icon.
; .
; #HTML(<img alt="key" src="../images/udgs/key.png">)
 $E098 LD A,$22      ; #REGa=Key icon left (#N$22).
 $E09A CALL $E6DC    ; Call #R$E6DC.
 $E09D LD A,$23      ; #REGa=Key icon right (#N$23).
 $E09F CALL $E6DC    ; Call #R$E6DC.
; Restore the default ZX Spectrum font.
 $E0A2 LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $E0A5 LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
 $E0A8 RET           ; Return.

; Print Status Bar
;
; Used by the routines at #R$DEA8 and #R$EE5B.
@label=PrintStatusBar
c$E0A9 CALL $A804    ; Call #R$A804.
; Restore the default ZX Spectrum font.
 $E0AC LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $E0AF LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
; Set up the attributes.
 $E0B2 LD A,$10      ; {Set INK: YELLOW (#N$06).
 $E0B4 RST $10       ;
 $E0B5 LD A,$06      ;
 $E0B7 RST $10       ; }
 $E0B8 LD A,$11      ; {Set PAPER: *#R$5BD0.
 $E0BA RST $10       ;
 $E0BB LD A,($5BD0)  ;
 $E0BE RST $10       ; }
; Set up the screen buffer position.
 $E0BF LD C,$21      ; {Set up the screen buffer location #N$01/#N$21 using
 $E0C1 LD B,$01      ; #SKOOLKID$0DD9(CL_SET).
 $E0C3 CALL $0DD9    ; }
; Print the status bar text at the bottom of the screen.
 $E0C6 LD B,$20      ; #REGb=#N$20 (length of status bar string).
 $E0C8 LD DE,$F2BB   ; #REGde=#R$F2BB.
@label=PrintStatusBar_Loop
*$E0CB LD A,(DE)     ; Fetch a character from *#REGde and store it in the
                     ; accumulator.
 $E0CC INC DE        ; Increment the string pointer by one.
 $E0CD CALL $E6DC    ; Call #R$E6DC.
 $E0D0 DJNZ $E0CB    ; Decrease the string length counter by one and loop back
                     ; to #R$E0CB until the string is printed.
; Prints the "Booty" count.
 $E0D2 LD C,$13      ; {Set up the screen buffer location #N$01/#N$13 using
 $E0D4 LD B,$01      ; #SKOOLKID$0DD9(CL_SET).
 $E0D6 CALL $0DD9    ; }
; Store *#R$5BF4 in #REGbc so we can use #SKOOLKID$1A1B(OUT_NUM_1) to print it
; to the screen.
 $E0D9 LD BC,($5BF4) ; #REGbc=*#R$5BF4.
 $E0DD CALL $1A1B    ; Call #SKOOLKID$1A1B(OUT_NUM_1).
; Prints the "Treasure" count.
 $E0E0 LD C,$05      ; {Set up the screen buffer location #N$01/#N$05 using
 $E0E2 LD B,$01      ; #SKOOLKID$0DD9(CL_SET).
 $E0E4 CALL $0DD9    ; }
; Store *#R$5BF2 in #REGbc so we can use #SKOOLKID$1A1B(OUT_NUM_1) to print it
; to the screen.
 $E0E7 LD BC,($5BF2) ; #REGbc=*#R$5BF2.
 $E0EB CALL $1A1B    ; Call #SKOOLKID$1A1B(OUT_NUM_1).
 $E0EE CALL $E064    ; Call #R$E064.
 $E0F1 LD A,($5BF2)  ; {Return if *#R$5BF2 is not equal to #N$00.
 $E0F4 CP $00        ;
 $E0F6 RET NZ        ; }
; This entry point is used by the routine at #R$E5F4.
@label=PrintFindTheGoldKey
*$E0F7 LD A,$10      ; {Set INK: WHITE (#N$07).
 $E0F9 RST $10       ;
 $E0FA LD A,$07      ;
 $E0FC RST $10       ; }
 $E0FD LD A,$11      ; {Set PAPER: *#R$5BD1.
 $E0FF RST $10       ;
 $E100 LD A,($5BD1)  ;
 $E103 RST $10       ; }
 $E104 LD B,$02      ; {Set up the screen buffer location #N$02/#N$21 using
 $E106 LD C,$21      ; #SKOOLKID$0DD9(CL_SET).
 $E108 CALL $0DD9    ; }
 $E10B LD B,$20      ; #HTML(#REGb=#N$20 (length of "find the gold key in
                     ; <em>xx</em> seconds" string).)
 $E10D LD DE,$E6BC   ; #REGde=#R$E6BC.
@label=PrintFindTheGoldKey_Loop
*$E110 LD A,(DE)     ; Fetch a character from *#REGde and store it in the
                     ; accumulator.
 $E111 CALL $E6DC    ; Call #R$E6DC.
 $E114 INC DE        ; Increment the string pointer by one.
 $E115 DJNZ $E110    ; Decrease the string length counter by one and loop back
                     ; to #R$E110 until the string is printed.
 $E117 RET           ; Return.

; Abort Animal Event
;
; Used by the routine at #R$E12A.
; .
; Clears the animal slot at #R$F31C when a spawn cannot proceed.
@label=AbortAnimalEvent
c$E118 POP HL        ; Restore the spawn-row pointer from the stack.
 $E119 LD A,$00      ; {Clear *#R$F31C (no animal is active).
 $E11B LD ($F31C),A  ; }
 $E11E RET           ; Return.

; Increased Frequency Animals Event Timing
;
; Used by the routine at #R$E12A.
@label=IncreasedFrequencyAnimalsEventTiming
c$E11F LD HL,($5C78) ; {Jump to #R$E13C if
 $E122 LD DE,$0352   ; *#SKOOLKID$5C78(FRAMES)
 $E125 SBC HL,DE     ; is higher than #N$0352.
 $E127 JR NC,$E13C   ; }
 $E129 RET           ; Else, return.

; Animals Event Timing
;
; Used by the routine at #R$E22D.
;
; .
;
; *#R$5BF4 starts at #N($0000,$04,$04) and counts up for every item of
; booty collected.
; This means that, the chance that animals appear increases when the player has
; collected over 100 items (of booty, not treasure - which counts down from #N($007D,$04,$04)).
@label=AnimalsEventTiming
c$E12A LD BC,($5BF4)   ; {If the player has collected over 100 items of booty
 $E12E LD A,C          ; (in *#R$5BF4) then jump to #R$E11F.
 $E12F CP $64          ;
 $E131 JR NC,$E11F     ; }
 $E133 LD HL,($5C78)   ; {Return if
 $E136 LD DE,$0578     ; *#SKOOLKID$5C78(FRAMES)
 $E139 SBC HL,DE       ; is lower than #N$0578.
 $E13B RET C           ; }
; This entry point is used by the routine at #R$E11F.
; .
; Use #SKOOLKID$5C78(FRAMES) as a counter.
@label=StartAnimalsEvent
*$E13C LD HL,$0000     ; {Reset
 $E13F LD ($5C78),HL   ; *#SKOOLKID$5C78(FRAMES)
                       ; to #N($0000,$04,$04) to start a new event cycle.}
; Pick a spawn row from #R$F317.
 $E142 CALL $E349      ; Call #R$E349.
 $E145 AND %00000011   ; Ensure the random number is between #N$00 and #N$03.
 $E147 LD HL,$F317     ; {Point #REGhl at that row in #R$F317.
 $E14A LD E,A          ;
 $E14B LD D,$00        ;
 $E14D ADD HL,DE       ; }
 $E14E PUSH HL         ; Stash the spawn-row pointer on the stack.
 $E14F INC HL          ; Advance to the next table byte.
 $E150 LD A,(HL)       ; #REGa=the door-row to match.
; Abort if a locked door already sits on that row.
 $E151 LD IX,($5BDA)   ; #REGix=*#R$5BDA.
 $E155 LD B,A          ; #REGb=the door-row to match.
*$E156 LD A,(IX+$00)   ; {Jump to #R$E172 if this entry is the terminator
 $E159 CP $FF          ; (#N$FF).
 $E15B JR Z,$E172      ; }
 $E15D LD A,(IX+$01)   ; {Jump to #R$E16B if this door's vertical is not the
 $E160 CP B            ; match row.
 $E161 JR NZ,$E16B     ; }
 $E163 LD A,(IX+$05)   ; {Jump to #R$E118 if a key or locked door already occupies
 $E166 CP $00          ; this row.
 $E168 JP NZ,$E118     ; }
*$E16B LD DE,$0006     ; {Move #REGix on to the next six-byte door entry.
 $E16E ADD IX,DE       ; }
 $E170 JR $E156        ; Jump to #R$E156.
*$E172 LD IX,$F31C     ; Point #REGix at #R$F31C.
; Choose whether the animal enters from the left or the right.
 $E176 CALL $E349      ; Call #R$E349.
 $E179 BIT 3,A         ; Test bit 3 of #REGa.
 $E17B JR Z,$E197      ; Jump to #R$E197 if the animal should enter from the
                       ; right.
; Enter from the left, moving left.
 $E17D LD (IX+$00),$02 ; Write the left-hand column (#N$02) to the horizontal
                       ; co-ordinate.
 $E181 LD (IX+$02),$01 ; Write #N$01 to the horizontal offset.
 $E185 LD (IX+$04),$01 ; Set horizontal movement to left (#N$01).
 $E189 LD (IX+$05),$00 ; Clear vertical movement.
 $E18D LD (IX+$0B),$01 ; Write #N$01 to the previous horizontal offset.
 $E191 LD (IX+$0D),$02 ; Write #N$02 to the previous horizontal co-ordinate.
 $E195 JR $E1AF        ; Jump to #R$E1AF.
; Enter from the right, moving right.
*$E197 LD (IX+$00),$25 ; Write the right-hand column (#N$25) to the horizontal
                       ; co-ordinate.
 $E19B LD (IX+$02),$00 ; Write #N$00 to the horizontal offset.
 $E19F LD (IX+$04),$FF ; Set horizontal movement to right (#N$FF).
 $E1A3 LD (IX+$05),$00 ; Clear vertical movement.
 $E1A7 LD (IX+$0B),$00 ; Write #N$00 to the previous horizontal offset.
 $E1AB LD (IX+$0D),$24 ; Write #N$24 to the previous horizontal co-ordinate.
; Choose a rat or a bird.
*$E1AF CALL $E349      ; Call #R$E349.
 $E1B2 BIT 5,A         ; Test bit 5 of #REGa.
 $E1B4 JR Z,$E1FE      ; Jump to #R$E1FE if this should be a bird.
; Spawn a rat on the chosen row, but only if that scanline is empty.
 $E1B6 POP HL          ; Restore the spawn-row pointer from the stack.
 $E1B7 PUSH HL         ; Stash the spawn-row pointer on the stack.
 $E1B8 LD A,(HL)       ; {Set up the screen buffer location #N$21/*#REGhl using
 $E1B9 LD B,A          ; #SKOOLKID$0DD9(CL_SET).
 $E1BA LD C,$21        ;
 $E1BC CALL $0DD9      ; }
 $E1BF LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E1C2 LD B,$20        ; #REGb=#N$20 (one character row).
*$E1C4 LD A,(HL)       ; Fetch a screen byte.
 $E1C5 INC HL          ; Advance the screen pointer.
 $E1C6 CP $FF          ; {Jump to #R$E118 if this byte is not empty (#N$FF).
 $E1C8 JP NZ,$E118     ; }
 $E1CB DJNZ $E1C4      ; Decrease counter by one and loop back to #R$E1C4 until the
                       ; whole row has been tested.
 $E1CD POP HL          ; Restore the spawn-row pointer from the stack.
 $E1CE LD A,(HL)       ; #REGa=the spawn row.
 $E1CF INC A           ; Increment #REGa by one.
 $E1D0 LD (IX+$01),A   ; Write it to the animal vertical co-ordinate.
 $E1D3 LD (IX+$0E),A   ; Write it to the previous vertical co-ordinate.
 $E1D6 LD (IX+$03),$03 ; Write #N$03 to the vertical offset.
 $E1DA LD (IX+$0F),$03 ; Write #N$03 to the previous vertical offset.
 $E1DE LD (IX+$06),$20 ; Write the first rat frame (#N$20) to the sprite ID.
 $E1E2 LD (IX+$09),$03 ; Write the rat attribute (#N$03).
 $E1E6 LD (IX+$07),$04 ; Write the rat width (#N$04).
 $E1EA LD (IX+$08),$01 ; Write the rat height (#N$01).
 $E1EE LD A,$01        ; {Queue the rat sound at #R$FFFF.
 $E1F0 LD ($FFFF),A    ; }
 $E1F3 LD A,(IX+$04)   ; {Return if the animal is moving left.
 $E1F6 CP $01          ;
 $E1F8 RET Z           ; }
 $E1F9 LD (IX+$06),$24 ; Else use the right-facing rat frame (#N$24).
 $E1FD RET             ; Return.
; Spawn a bird three rows below the chosen spawn row.
*$E1FE POP HL          ; Restore the spawn-row pointer from the stack.
 $E1FF LD A,(HL)       ; #REGa=the spawn row.
 $E200 INC A           ; {Add #N$03 for the bird's flying height.
 $E201 INC A           ;
 $E202 INC A           ; }
 $E203 LD (IX+$01),A   ; Write it to the animal vertical co-ordinate.
 $E206 LD (IX+$0E),A   ; Write it to the previous vertical co-ordinate.
 $E209 LD (IX+$03),$03 ; Write #N$03 to the vertical offset.
 $E20D LD (IX+$06),$28 ; Write the first bird frame (#N$28) to the sprite ID.
 $E211 LD (IX+$09),$06 ; Write the bird attribute (#N$06).
 $E215 LD (IX+$07),$02 ; Write the bird width (#N$02).
 $E219 LD (IX+$08),$02 ; Write the bird height (#N$02).
 $E21D LD A,$02        ; {Queue the bird sound at #R$FFFF.
 $E21F LD ($FFFF),A    ; }
 $E222 LD A,(IX+$04)   ; {Return if the animal is moving right.
 $E225 CP $FF          ;
 $E227 RET Z           ; }
 $E228 LD (IX+$06),$2C ; Else use the left-facing bird frame (#N$2C).
 $E22C RET             ; Return.

; Handler: Animals
;
; Used by the routine at #R$DEA8.
; .
; Moves, animates and collides the live animal at #R$F31C. If the
; slot is empty, #R$E12A may spawn one.
@label=Handler_Animals
c$E22D LD IX,$F31C     ; Point #REGix at #R$F31C.
 $E231 LD A,(IX+$00)   ; {Jump to #R$E12A if no animal is active.
 $E234 CP $00          ;
 $E236 JP Z,$E12A      ; }
; Point the UDG graphics at the animal frames.
 $E239 LD HL,$934C     ; {Write #R$944C(#N$934C) to *#SKOOLKID$5C36(CHARS).
 $E23C LD ($5C36),HL   ; }
 $E23F CALL $EEA6      ; Apply the animal's movement deltas.
 $E242 LD (IX+$00),C   ; Write the new horizontal co-ordinate back to the slot.
 $E245 LD (IX+$01),B   ; Write the new vertical co-ordinate back to the slot.
 $E248 LD (IX+$02),E   ; Write the new horizontal offset back to the slot.
 $E24B LD (IX+$03),D   ; Write the new vertical offset back to the slot.
; Erase the previous animal when it crosses a character boundary.
 $E24E LD A,E          ; {Jump to #R$E283 if the horizontal offset is not
 $E24F CP $03          ; #N$03.
 $E251 JR NZ,$E283     ; }
 $E253 LD A,(IX+$04)   ; {Jump to #R$E271 if the animal is moving right.
 $E256 CP $FF          ;
 $E258 JR Z,$E271      ; }
 $E25A LD A,C          ; #REGa=the new horizontal co-ordinate.
 $E25B SUB (IX+$07)    ; Subtract the animal width.
 $E25E CP $02          ; {Jump to #R$E283 if that column is off the left of the play
 $E260 JR C,$E283      ; area.}
 $E262 CP $22          ; {Jump to #R$E283 if that column is off the right of the play
 $E264 JR NC,$E283     ; area.}
 $E266 LD C,A          ; #REGc=the trail column to erase.
 $E267 LD E,$01        ; #REGe=#N$01 (one character wide).
 $E269 LD D,(IX+$08)   ; #REGd=the animal height.
 $E26C CALL $E787      ; Erase the previous animal from the room buffer.
 $E26F JR $E283        ; Jump to #R$E283.
*$E271 INC C           ; Step the trail column one to the right.
 $E272 LD A,C          ; {Jump to #R$E283 if that column is off the right of the play
 $E273 CP $22          ; area.
 $E275 JR NC,$E283     ; }
 $E277 CP $02          ; {Jump to #R$E283 if that column is off the left of the play
 $E279 JR C,$E283      ; area.}
 $E27B LD E,$01        ; #REGe=#N$01 (one character wide).
 $E27D LD D,(IX+$08)   ; #REGd=the animal height.
 $E280 CALL $E787      ; Erase the previous animal from the room buffer.
; Leave the screen, or animate and test a hit on the player.
*$E283 LD A,(IX+$00)   ; {Jump to #R$E301 if the animal has walked off the
 $E286 CP $26          ; right.
 $E288 JP Z,$E301      ; }
 $E28B CP $01          ; {Jump to #R$E301 if the animal has walked off the
 $E28D JP Z,$E301      ; left.}
 $E290 LD A,(IX+$06)   ; {Jump to #R$E29F if this is still a rat frame (below
 $E293 CP $25          ; #N$25).
 $E295 JR C,$E29F      ; }
 $E297 ADD A,$08       ; Advance the bird animation by one frame.
 $E299 CP $47          ; {Jump to #R$E29F if the bird frames have not wrapped.
 $E29B JR C,$E29F      ; }
 $E29D SUB $20         ; Wrap back to the first bird frame.
*$E29F LD (IX+$06),A   ; Write the new frame ID back to the slot.
 $E2A2 CALL $EED7      ; Print the animal.
 $E2A5 LD A,(IX+$00)   ; {Copy the horizontal co-ordinate to the previous-horizontal
 $E2A8 LD (IX+$0D),A   ; slot.}
 $E2AB LD A,(IX+$01)   ; {Copy the vertical co-ordinate to the
 $E2AE LD (IX+$0E),A   ; previous-vertical slot.}
 $E2B1 LD A,(IX+$02)   ; {Copy the horizontal offset to the previous-offset
 $E2B4 LD (IX+$0B),A   ; slot.}
 $E2B7 LD A,(IX+$03)   ; {Copy the vertical offset to the previous-vertical-offset
 $E2BA LD (IX+$0F),A   ; slot.}
; Test whether the animal overlaps the player.
 $E2BD LD A,(IX+$08)   ; #REGa=the animal height.
 $E2C0 ADD A,$03       ; Add #N$03 for the player's height.
 $E2C2 LD C,A          ; #REGc=the combined height.
 $E2C3 LD B,(IX+$01)   ; #REGb=the animal vertical co-ordinate.
 $E2C6 LD A,($F232)    ; #REGa=the player's vertical co-ordinate.
 $E2C9 DEC A           ; Decrease #REGa by one.
 $E2CA ADD A,(IX+$08)  ; Add the animal height.
 $E2CD SUB B           ; Subtract the animal vertical co-ordinate.
 $E2CE CP C            ; {Return if the player is outside the animal's vertical
 $E2CF RET NC          ; span.}
 $E2D0 LD A,(IX+$07)   ; #REGa=the animal width.
 $E2D3 ADD A,$02       ; Add #N$02.
 $E2D5 SLA A           ; {Convert that width into a pixel span.
 $E2D7 SLA A           ; }
 $E2D9 LD B,A          ; #REGb=the pixel width to test.
 $E2DA LD C,(IX+$00)   ; #REGc=the animal horizontal co-ordinate.
 $E2DD LD A,($F233)    ; {#REGd=the player's horizontal offset.
 $E2E0 LD D,A          ; }
 $E2E1 LD A,C          ; #REGa=the animal horizontal co-ordinate.
 $E2E2 SLA A           ; {Convert it to a pixel column.
 $E2E4 SLA A           ; }
 $E2E6 ADD A,(IX+$02)  ; {Add the animal's horizontal offset.
 $E2E9 LD C,A          ; }
 $E2EA LD A,($F231)    ; #REGa=the player's horizontal co-ordinate.
 $E2ED ADD A,(IX+$07)  ; Add the animal width.
 $E2F0 SLA A           ; Shift #REGa left (with carry).
 $E2F2 SLA A           ; Shift #REGa left (with carry).
 $E2F4 ADD A,D         ; Add the player's horizontal offset.
 $E2F5 DEC A           ; Decrease #REGa by one.
 $E2F6 SUB C           ; Subtract the animal's pixel column.
; See #POKE(immuneBirdsRats,Immune To Birds & Rats).
 $E2F7 CP B            ; {Return if the player is outside the animal's horizontal
 $E2F8 RET NC          ; span.}
 $E2F9 LD A,$01        ; {Queue the "touched by animal" sound at #R$FFFE.
 $E2FB LD ($FFFE),A    ; }
 $E2FE JP $E3A4        ; Jump to #R$E3A4 to lose a life.
; The animal has left the room; clear the slot.
*$E301 LD (IX+$00),$00 ; Clear *#R$F31C; no animal is active.
 $E305 LD A,$00        ; {Stop the animal sound at #R$FFFF.
 $E307 LD ($FFFF),A    ; }
 $E30A RET             ; Return.

; Player Controls Kempston
;
; Used by the routine at #R$DEA8.
@label=PlayerControls_Kempston
c$E30B LD IX,$F231   ; #REGix=#R$F231.
 $E30F LD A,($5BF0)  ; {Jump to #R$E31E if *#R$5BF0 is not set to "Demo Mode"
 $E312 CP $03        ; (#N$03).
 $E314 JR NZ,$E31E   ; }
 $E316 IN A,($1F)    ; Read from the Kempston joystick port.
 $E318 AND %00011111 ; Keep only bits 0-4.
 $E31A JP NZ,$ED8F   ; Jump to #R$ED8F if the result is not zero.
 $E31D RET           ; Return.
; The control is stored at *#R$F342 but does not appear to be referenced again
; outside of this routine.
@label=Check_PlayerControls_Kempston
*$E31E IN A,($1F)    ; Read from the Kempston joystick port.
 $E320 LD ($F342),A  ; Write #REGa to *#R$F342.
; Check for "fire".
 $E323 AND %00010000 ; Keep only bit 4.
 $E325 JP NZ,$EE5B   ; Jump to #R$EE5B if the result is not zero.
; Check for "right".
 $E328 LD A,($F342)  ; #REGa=*#R$F342.
 $E32B AND %00000001 ; Keep only bit 0.
 $E32D JP NZ,$EB05   ; Jump to #R$EB05 if the result is not zero.
; Check for "left".
 $E330 LD A,($F342)  ; #REGa=*#R$F342.
 $E333 AND %00000010 ; Keep only bit 1.
 $E335 JP NZ,$EB49   ; Jump to #R$EB49 if the result is not zero.
; Check for "down".
 $E338 LD A,($F342)  ; #REGa=*#R$F342.
 $E33B AND %00000100 ; Keep only bit 2.
 $E33D JP NZ,$ED9A   ; Jump to #R$ED9A if the result is not zero.
; Check for "up".
 $E340 LD A,($F342)  ; #REGa=*#R$F342.
 $E343 AND %00001000 ; Keep only bit 3.
 $E345 JP NZ,$EE08   ; Jump to #R$EE08 if the result is not zero.
; No controls were pressed, just return.
 $E348 RET           ; Return.

; Get Random Number
;
; Used by the routines at #R$DEA8, #R$E12A, #R$E361 and #R$E3C2.
;
; O:A The random number
;
; (((#REGb + #REGc) % #N$100 + #N$AB) % #N$100) * #N$100 + (#REGc + #N$CD) %
; #N$100
@label=GetRandomNumber
c$E349 PUSH BC       ; Stash #REGbc on the stack.
 $E34A LD BC,($F343) ; #REGbc=*#R$F343.
 $E34E XOR A         ; Reset the flags.
 $E34F LD A,C        ; {#REGb=#REGb+#REGc.
 $E350 ADD A,B       ;
 $E351 LD B,A        ; }
 $E352 XOR A         ; Reset the flags.
 $E353 LD A,$CD      ; {#REGc=#N$CD+#REGc.
 $E355 ADD A,C       ;
 $E356 LD C,A        ; }
 $E357 LD A,$AB      ; {#REGb+=#N$AB.
 $E359 ADC A,B       ;
 $E35A LD B,A        ; }
 $E35B LD ($F343),BC ; Write the updated #REGbc backit  to *#R$F343.
 $E35F POP BC        ; Restore #REGbc from the stack.
 $E360 RET           ; Return.

; Handler: Bad Door
;
; Used by the routine at #R$EE5B.
;
; .
;
; Fill the room up with water! This only occurs when opening the CYAN door in #R$C4F4(room #10).
; #PUSHS #UDGTABLE {
;   #POKES$5BF1,$04;$AAEF,$0A
;   #SIM(start=$CD56,stop=$CD60)
;   #SIM(start=$D08A,stop=$DF20)
;   #POKES$F232,$06;$F237,$98
;   #SIM(start=$DF2C,stop=$DF3A)
;   #SIM(start=$E366,stop=$E36B)
;   #FOR$01,$15||x|#SIM(start=$E36B,stop=$E3A1)
;     #SCR$02(*room-filling-with-water-x)#PLOT(0,0,0)(room-filling-with-water-x)
;   ||
;   #ANIMATE$12,$15(room-filling-with-water)
; } UDGTABLE# #POPS
; .
; Turn off any other sounds. Unclear why this isn't just set to #N$00
; (the checks in #R$F863 are from #N$01-#N$06).
@label=Handler_BadDoor
c$E361 LD A,$07      ; {Write #N$07 to *#R$FFFE.
 $E363 LD ($FFFE),A  ; }
 $E366 LD HL,$5AA0   ; Set the starting address in the attribute buffer
                     ; (#N$5AA0).
; And the number of lines to fill with "sea water".
 $E369 LD B,$15      ; #REGb=#N$15 (line counter).
; Start filling the room...
@label=Handler_BadDoor_Loop
*$E36B PUSH HL       ; {Stash the attribute buffer pointer and the line counter
 $E36C PUSH BC       ; on the stack.}
 $E36D LD B,$20      ; #REGb=#N$20 (number of character blocks in one line).
; Paint a whole line.
@label=BadDoor_FillLineLoop
*$E36F LD A,$29      ; {Write "#COLOUR$29" to *#REGhl.
 $E371 LD (HL),A     ; }
 $E372 INC HL        ; Increment the attribute buffer pointer by one.
 $E373 DJNZ $E36F    ; Decrease the character block counter by one and loop
                     ; back to #R$E36F until the whole line is blue.
; This sound wave noise is like white noise, so is good for giving the
; impression of rushing water.
; .
; #HTML(#AUDIO0(bad-door-water.wav)(#INCLUDE(BadDoorWater)))
 $E375 LD B,$C8      ; #REGb=#N$C8 (wave loop).
; Loop over the wave sound #N$C8 times.
@label=BadDoor_Wave_Loop
*$E377 PUSH BC       ; Stash the wave loop on the stack.
 $E378 LD BC,$FFFE   ; #REGbc=#N$FFFE (#REGc points to the speaker port).
 $E37B LD A,($5BD0)  ; #REGa=*#R$5BD0.
 $E37E ADD A,$10     ; Turn on the speaker (#REGa+=#N$10).
 $E380 OUT (C),A     ; Send #REGa to the speaker port.
; Set a random length delay.
 $E382 CALL $E349    ; Call #R$E349.
 $E385 LD B,A        ; #REGb=the random number.
@label=BadDoor_RandomDelay_Sound
*$E386 DJNZ $E386    ; Decrease the random counter by one and loop back to
                     ; #R$E386 until it is zero.
 $E388 LD BC,$FFFE   ; {Send *#R$5BD0 to the speaker port.
 $E38B LD A,($5BD0)  ;
 $E38E OUT (C),A     ; }
; Set another random length delay.
 $E390 CALL $E349    ; Call #R$E349.
 $E393 LD B,A        ; #REGb=the random number.
@label=BadDoor_RandomDelay_Silence
*$E394 DJNZ $E394    ; Decrease the random counter by one and loop back to
                     ; #R$E394 until it is zero.
 $E396 POP BC        ; Restore the wave loop from the stack.
 $E397 DJNZ $E377    ; Decrease the wave loop by one and loop back to #R$E377
                     ; until the counter is zero.
; Restore our positions from the start of the main loop.
 $E399 POP BC        ; {Restore the line counter and the attribute buffer
 $E39A POP HL        ; pointer from the stack.}
; Move "up" one line in the attribute buffer, ready to start painting again
; once we loop.
 $E39B LD DE,$0020   ; #REGde=#N($0020,$04,$04).
 $E39E XOR A         ; Reset the flags.
 $E39F SBC HL,DE     ; #REGhl-=#REGde (with carry).
 $E3A1 DJNZ $E36B    ; Decrease the line counter by one and loop back to
                     ; #R$E36B until the whole play area is filled.
; This entry point is used by the routine at #R$E3E0.
@label=HousekeepStackThenLoseLife
*$E3A3 POP BC        ; Restore #REGbc from the stack.
; Continue on to #R$E3A4.

; Lose A Life
;
; Used by the routines at #R$DFCB, #R$E22D, #R$EBD8 and #R$F001.
@label=LoseLife
c$E3A4 LD A,$01      ; {Write #N$01 to *#R$FFFB.
 $E3A6 LD ($FFFB),A  ; }
 $E3A9 POP BC        ; Restore #REGbc from the stack.
 $E3AA LD HL,$0064   ; #REGhl=#N($0064,$04,$04).
 $E3AD LD DE,$00C8   ; #REGde=#N($00C8,$04,$04).
; #HTML(#AUDIO0(lose-life.wav)(#INCLUDE(LoseLife)))
 $E3B0 CALL $03B5    ; Call #SKOOLKID$03B5(BEEPER).
; See #POKE(infiniteLives,Infinite Lives).
 $E3B3 LD A,($5BF1)  ; {Decrease *#R$5BF1 by one.
 $E3B6 DEC A         ;
 $E3B7 LD ($5BF1),A  ; }
 $E3BA CP $FF        ; {Call #R$ED8F if *#R$5BF1 is equal to #N$FF.
 $E3BC CALL Z,$ED8F  ; }
; See #POKE(dontGoBackStart,Don't Go Back To Start)
 $E3BF JP $DEC9      ; Jump to #R$DEC9.

; Controller: Is There A Bomb?
;
; Used by the routine at #R$E5F4.
;
; BC Position coordinates for where to place the bomb
@label=Controller_BombCheck
c$E3C2 CALL $E349    ; Call #R$E349.
 $E3C5 CP $40        ; {Return if the random number is higher than #N$40.
 $E3C7 RET NC        ; }
; See #POKE(bombsDontExplode,Bombs Don't Explode).
 $E3C8 LD A,($E479)  ; {Return if *#R$E479 indicates a bomb already exists on
 $E3CB CP $00        ; the screen - we can only process one at-a-time.
 $E3CD RET NZ        ; }
; We're good to create a bomb!
 $E3CE LD A,$20      ; {Set the base sprite (#R$934C(#N$20)) to *#R$E475.
 $E3D0 LD ($E475),A  ; }
 $E3D3 LD ($E46F),BC ; Write the coordinates (#REGbc) to *#R$E46F for where it
                     ; should appear.
; Initialise the bomb, and the sound for it.
 $E3D7 LD A,$01      ; {Write #N$01 to: #LIST { *#R$E479 } { *#R$FFFD } LIST#
 $E3D9 LD ($E479),A  ;
 $E3DC LD ($FFFD),A  ; }
 $E3DF RET           ; Return.

; Handler: Explosion
;
; Used by the routine at #R$DEA8.
@label=Handler_Explosion
c$E3E0 LD A,($F2DB)    ; {Return if *#R$F2DB has no active sparks.
 $E3E3 CP $00          ;
 $E3E5 RET Z           ; }
 $E3E6 LD IX,$F2DB     ; Point #REGix at #R$F2DB.
 $E3EA LD HL,$F15B     ; {Write #R$F25B(#N$F15B) to *#SKOOLKID$5C36(CHARS).
 $E3ED LD ($5C36),HL   ; }
 $E3F0 LD A,$10        ; {Set INK: WHITE (#N$07).
 $E3F2 RST $10         ;
 $E3F3 LD A,$07        ;
 $E3F5 RST $10         ; }
 $E3F6 LD B,$05        ; #REGb=#N$05 (five sparks).
@label=Handler_Explosion_Loop
*$E3F8 PUSH BC         ; Stash the sparks counter on the stack.
 $E3F9 LD B,(IX+$01)   ; #REGb=this spark's vertical co-ordinate.
 $E3FC LD DE,$0101     ; Set the spark width/ height to #N$01/ #N$01.
 $E3FF LD C,(IX+$00)   ; #REGc=this spark's horizontal co-ordinate.
 $E402 LD A,C          ; {Jump to #R$E412 if the spark is off the right.
 $E403 CP $22          ;
 $E405 JR NC,$E412     ; }
 $E407 CP $02          ; {Jump to #R$E412 if the spark is off the left.
 $E409 JR C,$E412      ; }
 $E40B PUSH BC         ; {Stash the spark position and size on the stack.
 $E40C PUSH DE         ; }
 $E40D CALL $E787      ; Erase the spark's previous tile.
 $E410 POP DE          ; {Restore the spark position and size from the stack.
 $E411 POP BC          ; }
*$E412 LD A,(IX+$03)   ; {Add the spark's vertical velocity.
 $E415 ADD A,B         ;
 $E416 LD B,A          ; }
 $E417 LD A,(IX+$02)   ; {Add the spark's horizontal velocity.
 $E41A ADD A,C         ;
 $E41B LD C,A          ; }
 $E41C INC (IX+$05)    ; Advance this spark's timer.
 $E41F LD A,(IX+$05)   ; {Jump to #R$E464 if this spark has finished.
 $E422 CP $04          ;
 $E424 JR Z,$E464      ; }
 $E426 LD A,C          ; {Jump to #R$E45B if the new column is off the right.
 $E427 CP $22          ;
 $E429 JR NC,$E45B     ; }
 $E42B CP $02          ; {Jump to #R$E45B if the new column is off the left.
 $E42D JR C,$E45B      ; }
 $E42F LD (IX+$00),C   ; Write the new horizontal co-ordinate back to the
                       ; spark.
 $E432 LD (IX+$01),B   ; Write the new vertical co-ordinate back to the spark.
 $E435 LD DE,$0101     ; Set the spark width/ height to #N$01/ #N$01.
 $E438 LD A,$20        ; #REGa=the spark sprite ID.
 $E43A CALL $EA93      ; Print the spark.
 $E43D LD B,(IX+$01)   ; #REGb=the spark vertical co-ordinate.
 $E440 LD A,($F232)    ; #REGa=*#R$F232.
 $E443 SUB B           ; Subtract the spark vertical.
 $E444 CP $02          ; {Jump to #R$E45B if the player is outside this spark's
 $E446 JR NC,$E45B     ; vertical span.}
 $E448 LD C,(IX+$00)   ; #REGc=the spark horizontal co-ordinate.
 $E44B LD A,($F231)    ; #REGa=*#R$F231.
 $E44E SUB C           ; Subtract the spark horizontal.
 $E44F CP $02          ; {Jump to #R$E45B if the player is outside this spark's
 $E451 JR NC,$E45B     ; horizontal span.}
 $E453 LD A,$03        ; {Queue the bomb-explosion sound at #R$FFFE.
 $E455 LD ($FFFE),A    ; }
 $E458 JP $E3A3        ; Jump to #R$E3A3 to lose a life.
@label=Handler_Explosion_Next
*$E45B LD DE,$0006     ; {Move #REGix on to the next six-byte spark entry.
 $E45E ADD IX,DE       ; }
 $E460 POP BC          ; Restore the sparks counter from the stack.
 $E461 DJNZ $E3F8      ; Decrease the sparks counter by one and loop back to
                       ; #R$E3F8 until every spark has been processed.
 $E463 RET             ; Return.
; This spark has run its course, remove it.
@label=Handler_Explosion_Housekeep
*$E464 LD (IX+$00),$00 ; Clear this spark's horizontal co-ordinate.
 $E468 LD A,$00        ; {Clear the bomb sound at #R$FFFD.
 $E46A LD ($FFFD),A    ; }
 $E46D JR $E45B        ; Jump to #R$E45B.

; Table: Bomb
@label=TableBomb_Position
g$E46F DEFB $00,$00
 $E471 DEFB $00
 $E472 DEFB $00
 $E473 DEFB $00
 $E474 DEFB $00
@label=TableBomb_SpriteID
 $E475 DEFB $00
 $E476 DEFB $00
 $E477 DEFB $00
 $E478 DEFB $00
@label=TableBomb_Flag
 $E479 DEFB $00

; Handler: Bomb
;
; Used by the routine at #R$DEA8.
@label=Handler_Bomb
c$E47A LD A,($E479)  ; {Return if *#R$E479 shows no bomb on screen.
 $E47D CP $00        ;
 $E47F RET Z         ; }
; Only continue every other frame.
 $E480 LD A,($F341)  ; #REGa=*#R$F341.
 $E483 INC A         ; Increment #REGa by one.
 $E484 AND %00000001 ; Keep *#R$F341 as #N$00 or #N$01.
 $E486 LD ($F341),A  ; Write #REGa back to *#R$F341.
 $E489 CP $00        ; {Return if *#R$F341 is a skipped frame.
 $E48B RET NZ        ; }
; Set up the bomb graphic.
 $E48C LD HL,$924C   ; {Write #R$934C(#N$924C) to *#SKOOLKID$5C36(CHARS).
 $E48F LD ($5C36),HL ; }
 $E492 LD A,$10      ; {Set INK: YELLOW (#N$06).
 $E494 RST $10       ;
 $E495 LD A,$06      ;
 $E497 RST $10       ; }
; The fuse burning down acts as a countdown before the explosion.
 $E498 LD A,($E475)  ; #REGa=*#R$E475.
 $E49B ADD A,$04     ; Advance to the next fuse frame.
 $E49D CP $40        ; {Jump to #R$E4AF if the fuse has burned down.
 $E49F JR Z,$E4AF    ; }
 $E4A1 LD ($E475),A  ; Write the new fuse frame back to *#R$E475.
; Print the bomb on the screen.
 $E4A4 LD BC,($E46F) ; #REGbc=*#R$E46F.
 $E4A8 LD DE,$0202   ; Set the bomb width/ height to #N$02/ #N$02.
 $E4AB CALL $EA93    ; Print the bomb.
 $E4AE RET           ; Return.
; The fuse has burned down; start the explosion.
@label=IgniteBomb
*$E4AF LD BC,($E46F) ; #REGbc=*#R$E46F.
 $E4B3 LD DE,$0202   ; Set the bomb width/ height to #N$02/ #N$02.
 $E4B6 CALL $E787    ; Erase the bomb from the room.
 $E4B9 LD A,$00      ; {Write #N$00 to: #LIST { *#R$FFFD } { *#R$E479 } LIST#
 $E4BB LD ($FFFD),A  ;
 $E4BE LD ($E479),A  ; }
 $E4C1 LD A,($F2DB)  ; {Return if *#R$F2DB already has an explosion in
 $E4C4 CP $00        ; progress.
 $E4C6 RET NZ        ; }
; There are #N$05 sparks, and each occupies #N$06 bytes.
 $E4C7 LD DE,$F2DB   ; {Copy the default sparks from #R$F2F9 to #R$F2DB.
 $E4CA LD HL,$F2F9   ;
 $E4CD LD BC,$001E   ;
 $E4D0 LDIR          ; }
 $E4D2 LD BC,($E46F) ; #REGbc=*#R$E46F.
 $E4D6 DEC B         ; Move down one row from the bomb.
; Give every spark the bomb's starting co-ordinates.
 $E4D7 LD IX,$F2DB   ; Point #REGix at #R$F2DB.
 $E4DB LD L,$05      ; #REGl=#N$05 (number of sparks).
@label=SetSparksStartingPosition
*$E4DD LD (IX+$00),C ; Write the bomb column to this spark.
 $E4E0 LD (IX+$01),B ; Write the bomb row to this spark.
 $E4E3 LD DE,$0006   ; {Move #REGix on to the next spark.
 $E4E6 ADD IX,DE     ; }
 $E4E8 DEC L         ; Decrease the spark counter by one.
 $E4E9 JR NZ,$E4DD   ; Jump to #R$E4DD until every spark has a start position.
 $E4EB LD A,$02      ; {Queue the sparks sound at #R$FFFD.
 $E4ED LD ($FFFD),A  ; }
 $E4F0 RET           ; Return.

; Handler: Lift Masks
;
; Used by the routine at #R$DEA8.
; .
; Writes #N$FF into the display file at each lift that is not on
; sub-row #N$00. Called from the game loop after #R$E821.
@label=Handler_LiftMasks
c$E4F1 LD IX,($5BE4) ; Point #REGix at #R$5BE4.
; Walk the lift table painting a mask under each moving lift.
@label=Handler_LiftMasks_Loop
*$E4F5 LD A,(IX+$00) ; {Return if this lift entry is the terminator (#N$FF).
 $E4F8 CP $FF        ;
 $E4FA RET Z         ; }
 $E4FB LD A,(IX+$05) ; {Jump to #R$E531 if this lift has no vertical movement.
 $E4FE CP $00        ;
 $E500 JR Z,$E531    ; }
 $E502 LD C,(IX+$00) ; #REGc=the lift horizontal co-ordinate.
 $E505 LD B,(IX+$01) ; #REGb=the lift vertical co-ordinate.
 $E508 LD A,(IX+$03) ; {Jump to #R$E547 if the lift is on sub-row #N$03.
 $E50B CP $03        ;
 $E50D JR Z,$E547    ; }
 $E50F CP $02        ; {Jump to #R$E538 if the lift is on sub-row #N$02.
 $E511 JR Z,$E538    ; }
 $E513 CP $01        ; {Jump to #R$E554 if the lift is on sub-row #N$01.
 $E515 JR Z,$E554    ; }
 $E517 DEC B         ; Move one row up for sub-row #N$00.
 $E518 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
*$E51B LD D,$04      ; #REGd=#N$04 (four pixel rows of mask).
*$E51D LD B,(IX+$07) ; #REGb=the lift width.
 $E520 LD A,$FF      ; #REGa=#N$FF (solid mask byte).
 $E522 LD HL,($5C84) ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E525 INC H         ; Increment #REGh by one.
 $E526 LD ($5C84),HL ; Write #REGhl to *#SKOOLKID$5C84(DF_CC).
 $E529 DEC H         ; Decrease #REGh by one.
*$E52A LD (HL),A     ; Write the mask byte into the display file.
 $E52B INC HL        ; Advance one column.
 $E52C DJNZ $E52A    ; Decrease the width counter by one and loop back to #R$E52A
                     ; until this pixel row is masked.
 $E52E DEC D         ; Move on to the next pixel row.
 $E52F JR NZ,$E51D   ; Jump to #R$E51D until all four rows are masked.
*$E531 LD DE,$0010   ; {Move #REGix on to the next sixteen-byte lift entry.
 $E534 ADD IX,DE     ; }
 $E536 JR $E4F5      ; Jump to #R$E4F5.
; Mask from two pixel rows further down (sub-row #N$02).
*$E538 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $E53B LD HL,($5C84) ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E53E INC H         ; {Increment #REGh by four.
 $E53F INC H         ;
 $E540 INC H         ;
 $E541 INC H         ; }
 $E542 LD ($5C84),HL ; Write #REGhl to *#SKOOLKID$5C84(DF_CC).
 $E545 JR $E51B      ; Jump to #R$E51B.
; Mask from one pixel row further down (sub-row #N$03).
*$E547 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $E54A LD HL,($5C84) ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E54D INC H         ; {Increment #REGh by two.
 $E54E INC H         ; }
 $E54F LD ($5C84),HL ; Write #REGhl to *#SKOOLKID$5C84(DF_CC).
 $E552 JR $E51B      ; Jump to #R$E51B.
; Mask from three pixel rows further down (sub-row #N$01).
*$E554 PUSH BC       ; Stash the lift co-ordinates on the stack.
 $E555 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $E558 LD HL,($5C84) ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E55B LD A,H        ; {#REGh+=#N$06.
 $E55C ADD A,$06     ;
 $E55E LD H,A        ; }
 $E55F LD ($5C84),HL ; Write #REGhl to *#SKOOLKID$5C84(DF_CC).
 $E562 LD D,$02      ; #REGd=#N$02 (two pixel rows of mask).
*$E564 LD HL,($5C84) ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E567 INC H         ; Increment #REGh by one.
 $E568 LD ($5C84),HL ; Write #REGhl to *#SKOOLKID$5C84(DF_CC).
 $E56B DEC H         ; Decrease #REGh by one.
 $E56C LD A,$FF      ; #REGa=#N$FF (solid mask byte).
 $E56E LD B,(IX+$07) ; #REGb=the lift width.
*$E571 LD (HL),A     ; Write the mask byte into the display file.
 $E572 INC HL        ; Advance one column.
 $E573 DJNZ $E571    ; Decrease the width counter by one and loop back to #R$E571
                     ; until this pixel row is masked.
 $E575 DEC D         ; Move on to the next pixel row.
 $E576 JR NZ,$E564   ; Jump to #R$E564 until both rows are masked.
 $E578 POP BC        ; Restore the lift co-ordinates from the stack.
 $E579 DEC B         ; Move one row up.
 $E57A CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $E57D LD D,$02      ; #REGd=#N$02 (two more pixel rows of mask).
 $E57F JR $E51D      ; Jump to #R$E51D.

; Handler: Disappearing Floors
;
; Used by the routine at #R$DEA8.
@label=Handler_DisappearingFloors
c$E581 LD IX,($5BE6)   ; Point #REGix at *#R$5BE6.
; Walk the disappearing-floor table.
@label=Handler_DisappearingFloors_Loop
*$E585 LD A,(IX+$00)   ; {Return if this floor entry is the terminator (#N$FF).
 $E588 CP $FF          ;
 $E58A RET Z           ; }
; Bit 7 of the width byte holds whether the floor is visible.
 $E58B LD A,(IX+$02)   ; #REGa=this floor's width and visibility state.
 $E58E AND %10000000   ; Keep only the visibility state.
 $E590 JP Z,$E5C5      ; Jump to #R$E5C5 if the floor is currently visible.
; The floor is hidden; print empty space from #R$A06C.
 $E593 LD HL,$9F6C     ; {Write #R$A06C(#N$9F6C) to *#SKOOLKID$5C36(CHARS).
 $E596 LD ($5C36),HL   ; }
 $E599 INC (IX+$05)    ; Advance this floor's change timer.
; Stay hidden until the disappeared-timer count elapses.
 $E59C LD A,(IX+$04)   ; {Jump to #R$E5B0 if the hidden timer has not elapsed.
 $E59F CP (IX+$05)     ;
 $E5A2 JR NZ,$E5B0     ; }
; Time to bring the floor back.
 $E5A4 LD A,(IX+$02)   ; #REGa=this floor's width and visibility state.
 $E5A7 AND %01111111   ; Clear the hidden state so the floor will show next
                       ; cycle.
 $E5A9 LD (IX+$02),A   ; Write the updated width and state back.
 $E5AC LD (IX+$05),$00 ; Reset this floor's change timer.
; Print blank tiles where the floor should be. The visible
; path at #R$E5DC also updates the room buffer.
@label=PrintDisappearedFloor
*$E5B0 LD C,(IX+$00)   ; #REGc=the floor's horizontal co-ordinate.
 $E5B3 LD B,(IX+$01)   ; #REGb=the floor's vertical co-ordinate.
; Bits 0-6 hold the floor width.
 $E5B6 LD A,(IX+$02)   ; #REGa=this floor's width and visibility state.
 $E5B9 AND %01111111   ; Keep only the width.
 $E5BB LD E,A          ; #REGe=the floor width.
 $E5BC LD D,$01        ; #REGd=#N$01 (floors are one row high).
 $E5BE LD A,$20        ; #REGa=a blank tile.
 $E5C0 CALL $EA93      ; Print the empty floor space.
 $E5C3 JR $E5ED        ; Jump to #R$E5ED.
; The floor is visible; count down until it should vanish.
@label=DisplayFloor
*$E5C5 LD A,(IX+$03)   ; Fetch how long this floor stays visible.
 $E5C8 INC (IX+$05)    ; Advance this floor's change timer.
 $E5CB CP (IX+$05)     ; {Jump to #R$E5DC if the visible timer has not elapsed.
 $E5CE JR NZ,$E5DC     ; }
; Time to hide the floor.
 $E5D0 LD A,(IX+$02)   ; #REGa=this floor's width and visibility state.
 $E5D3 OR %10000000    ; Set the hidden state so the floor will vanish next
                       ; cycle.
 $E5D5 LD (IX+$02),A   ; Write the updated width and state back.
 $E5D8 LD (IX+$05),$00 ; Reset this floor's change timer.
; Draw the floor and update the room buffer.
@label=PrintVisibleFloor
*$E5DC LD C,(IX+$00)   ; #REGc=the floor's horizontal co-ordinate.
 $E5DF LD B,(IX+$01)   ; #REGb=the floor's vertical co-ordinate.
; Bits 0-6 hold the floor width.
 $E5E2 LD A,(IX+$02)   ; #REGa=this floor's width and visibility state.
 $E5E5 AND %01111111   ; Keep only the width.
 $E5E7 LD E,A          ; #REGe=the floor width.
 $E5E8 LD D,$01        ; #REGd=#N$01 (floors are one row high).
 $E5EA CALL $E787      ; Print the floor and update the room buffer.
; Move onto the next disappearing floor.
@label=DisappearingFloors_Next
*$E5ED LD DE,$0006     ; {Move #REGix on to the next six-byte floor entry.
 $E5F0 ADD IX,DE       ; }
 $E5F2 JR $E585        ; Jump to #R$E585.

; Handler: Items
;
; Used by the routine at #R$DEA8.
@label=Handler_Items
c$E5F4 LD IX,($5BE0)   ; Point #REGix at *#R$5BE0.
; Walk the item table looking for one the player is standing on.
@label=Handler_Items_Loop
*$E5F8 LD A,(IX+$00)   ; {Return if this item entry is the terminator (#N$FF).
 $E5FB CP $FF          ;
 $E5FD RET Z           ; }
 $E5FE LD C,A          ; #REGc=this item's horizontal co-ordinate.
 $E5FF LD B,(IX+$01)   ; #REGb=this item's vertical co-ordinate.
 $E602 LD A,(IX+$05)   ; {Jump to #R$E61A if this item has already been
 $E605 CP $00          ; collected.
 $E607 JR Z,$E61A      ; }
 $E609 LD A,($F232)    ; #REGa=*#R$F232.
 $E60C DEC A           ; Move one row up to the player's feet.
 $E60D CP B            ; {Jump to #R$E61A if the player is not on this item's
 $E60E JR NZ,$E61A     ; row.}
 $E610 LD A,($F231)    ; #REGa=*#R$F231.
 $E613 SUB C           ; Subtract the item column.
 $E614 JR Z,$E621      ; {Jump to #R$E621 if the player is in this item's
 $E616 CP $FF          ; column.
 $E618 JR Z,$E621      ; }
@label=Handler_Items_Next
*$E61A LD DE,$0007     ; {Move #REGix on to the next seven-byte item entry.
 $E61D ADD IX,DE       ; }
 $E61F JR $E5F8        ; Jump to #R$E5F8.
@label=Item_Collected
*$E621 CALL $E3C2      ; Maybe place a bomb at this item.
 $E624 LD A,$04        ; {Queue the collected-item sound at #R$FFFE.
 $E626 LD ($FFFE),A    ; }
 $E629 LD A,$00        ; #REGa=#N$00.
 $E62B LD D,$02        ; {Set the blank sprite width/ height (#N$02/ #N$02).
 $E62D LD E,$02        ; }
 $E62F PUSH DE         ; Stash the blank size on the stack.
 $E630 CALL $E72F      ; Blank the item in the game sprite buffer.
 $E633 CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E636 POP DE          ; Restore the blank size from the stack.
 $E637 LD HL,$9F6C     ; {Write #R$A06C(#N$9F6C) to *#SKOOLKID$5C36(CHARS).
 $E63A LD ($5C36),HL   ; }
 $E63D LD A,$20        ; #REGa=a blank character.
 $E63F CALL $EA93      ; Print the blank over the item.
 $E642 LD (IX+$05),$00 ; Mark this item as collected.
 $E646 LD A,$10        ; {Set INK: YELLOW (#N$06).
 $E648 RST $10         ;
 $E649 LD A,$06        ;
 $E64B RST $10         ; }
 $E64C LD A,$11        ; {Set PAPER: *#R$5BD0.
 $E64E RST $10         ;
 $E64F LD A,($5BD0)    ;
 $E652 RST $10         ; }
; Restore the default ZX Spectrum font.
 $E653 LD HL,$3C00     ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $E656 LD ($5C36),HL   ; *#SKOOLKID$5C36(CHARS).}
 $E659 LD C,$13        ; {Move the cursor to the booty count.
 $E65B LD B,$01        ;
 $E65D CALL $0DD9      ; }
 $E660 LD BC,($5BF4)   ; {Increment *#R$5BF4 by one.
 $E664 INC BC          ;
 $E665 LD ($5BF4),BC   ; }
 $E669 CALL $1A1B      ; Print the new booty count.
 $E66C LD C,$05        ; {Move the cursor to the treasure count.
 $E66E LD B,$01        ;
 $E670 CALL $0DD9      ; }
 $E673 LD BC,($5BF2)   ; {Decrease *#R$5BF2 by one.
 $E677 DEC BC          ;
 $E678 LD ($5BF2),BC   ; }
 $E67C LD A,B          ; {Jump to #R$E699 if the remaining treasure is not
 $E67D CP $00          ; #N$0032.
 $E67F JR NZ,$E699     ; }
 $E681 LD A,C          ; {Jump to #R$E699 if the remaining low byte is not
 $E682 CP $32          ; #N$32.
 $E684 JR NZ,$E699     ; }
 $E686 LD A,($5BD3)    ; {Record the current room in *#R$5BFC.
 $E689 LD ($5BFC),A    ; }
 $E68C LD A,(IX+$00)   ; {Record this item's column in *#R$5BFD.
 $E68F LD ($5BFD),A    ; }
 $E692 LD A,(IX+$01)   ; #REGa=this item's row.
 $E695 INC A           ; Move one row down for the golden-key position.
 $E696 LD ($5BFE),A    ; Write it to *#R$5BFE.
*$E699 LD A,C          ; {Test whether any treasure remains.
 $E69A CP $00          ; }
 $E69C PUSH AF         ; Stash that result on the stack.
 $E69D CALL NZ,$1A1B   ; Print the remaining treasure if it is not zero.
 $E6A0 LD A,$20        ; #REGa=ASCII "space" (#N$20).
 $E6A2 CALL $E6DC      ; Call #R$E6DC.
 $E6A5 POP AF          ; Restore the remaining-treasure result from the stack.
 $E6A6 RET NZ          ; Return if treasure still remains.
 $E6A7 LD A,$2D        ; {Start *#R$5BFF at #N$2D seconds.
 $E6A9 LD ($5BFF),A    ; }
 $E6AC LD BC,$0014     ; {Write the golden-key frame skip to *#R$5BFA.
 $E6AF LD ($5BFA),BC   ; }
; Restore the default ZX Spectrum font.
 $E6B3 LD HL,$3C00     ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $E6B6 LD ($5C36),HL   ; *#SKOOLKID$5C36(CHARS).}
 $E6B9 JP $E0F7        ; Jump to #R$E0F7.

; Messaging: Find The Gold Key
@label=Messaging_FindTheGoldKey
t$E6BC DEFM "FIND THE GOLD KEY IN    SECONDS!" ; "#STR(#PC,$04,$20)".

; Print Colour Character
;
; Used by the routines at #R$DEA8, #R$DFD3, #R$E064, #R$E0A9, #R$E5F4, #R$E787,
; #R$EA93 and #R$EED7.
;
; A Character to print
@label=PrintColourCharacter
c$E6DC EXX           ; Switch to the shadow registers.
 $E6DD LD E,A        ; {#REGde'=#REGa*#N$08.
 $E6DE LD D,$00      ;
 $E6E0 SLA E         ;
 $E6E2 RL D          ;
 $E6E4 SLA E         ;
 $E6E6 RL D          ;
 $E6E8 SLA E         ;
 $E6EA RL D          ; }
 $E6EC LD HL,($5C36) ; {#REGhl'=*#SKOOLKID$5C36(CHARS)+#REGde'.
 $E6EF ADD HL,DE     ; }
 $E6F0 LD DE,($5C84) ; {Increment *#SKOOLKID$5C84(DF_CC) by one.
 $E6F4 INC DE        ;
 $E6F5 LD ($5C84),DE ; }
 $E6F9 DEC DE        ; Decrease #REGde' by one.
; All character blocks are 1 x 8 bytes.
; .
; Copy the data from the current character set to the screen buffer.
 $E6FA LD B,$08      ; #REGb'=#N$08 (byte counter).
@label=PrintColourCharacter_Loop
*$E6FC LD A,(HL)     ; Fetch the byte from the character set.
 $E6FD LD (DE),A     ; Write the byte to the screen buffer.
 $E6FE INC HL        ; Increment the character set data pointer in #REGhl' by
                     ; one.
 $E6FF INC D         ; Move down one line in the screen buffer.
 $E700 DJNZ $E6FC    ; Decrease the byte counter by one and loop back to
                     ; #R$E6FC until all lines of the letter have been written
                     ; to the screen buffer.
; Calculate the attribute buffer position.
 $E702 LD BC,($5C88) ; #REGbc'=*#SKOOLKID$5C88(S_POSN).
 $E706 LD HL,$5800   ; #REGhl'=#N$5800 (attribute buffer location).
 $E709 DEC C         ; Decrease #REGc' by one.
 $E70A LD ($5C88),BC ; Write #REGbc' to *#SKOOLKID$5C88(S_POSN).
 $E70E INC C         ; Increment #REGc' by one.
 $E70F LD A,$21      ; {#REGe'=#N$21-#REGc'.
 $E711 SUB C         ;
 $E712 LD E,A        ; }
 $E713 LD D,$00      ; #REGd'=#N$00.
 $E715 ADD HL,DE     ; #REGhl'+=#REGde'.
 $E716 LD A,$18      ; {#REGe'=#N$18-#REGb'.
 $E718 SUB B         ;
 $E719 LD E,A        ; }
 $E71A SLA E         ; {Shift #REGe' left four positions (with carry).
 $E71C SLA E         ;
 $E71E SLA E         ;
 $E720 SLA E         ; }
 $E722 RL D          ; Rotate #REGd' left.
 $E724 SLA E         ; Shift #REGe' left (with carry).
 $E726 RL D          ; Rotate #REGd' left.
 $E728 ADD HL,DE     ; #REGhl'+=#REGde'.
 $E729 LD A,($5C8F)  ; #REGa=*#SKOOLKID$5C8F(ATTR_T).
 $E72C LD (HL),A     ; Write #REGa to *#REGhl'.
 $E72D EXX           ; Switch back to the normal registers.
 $E72E RET           ; Return.

; Write Game Sprite Buffer
;
; Used by the routines at #R$E5F4, #R$EB8D and #R$F107.
; .
; Writes a sprite into the in-game room buffer. Clone of #R$A83F.
;
; A Starting sprite ID
; B Vertical position
; C Horizontal position
; D Height
; E Width
@label=WriteGameSpriteBuffer
c$E72F PUSH AF       ; {Stash the registers this tile walk uses.
 $E730 PUSH BC       ;
 $E731 PUSH DE       ;
 $E732 PUSH HL       ; }
 $E733 DEC A         ; Start one ID before the first tile so the increment
                     ; lands on it.
 $E734 LD ($F336),A  ; Write the tile ID to *#R$F336.
 $E737 LD A,E        ; {Remember the remaining width in *#R$F335.
 $E738 LD ($F335),A  ; }
*$E73B LD A,($F335)  ; {Reload the remaining width.
 $E73E LD E,A        ; }
 $E73F PUSH BC       ; {Stash the position and size.
 $E740 PUSH DE       ; }
 $E741 CALL $E762    ; Convert this tile into a room-buffer offset.
 $E744 POP DE        ; {Restore the position and size.
 $E745 POP BC        ; }
*$E746 LD A,($F336)  ; #REGa=*#R$F336.
 $E749 INC A         ; Advance to the next tile ID.
 $E74A CP $00        ; {Jump to #R$E751 if the tile ID wrapped.
 $E74C JR Z,$E751    ; }
 $E74E LD ($F336),A  ; Write it back to *#R$F336.
*$E751 CALL $E804    ; Write that tile into the game room buffer.
 $E754 DEC E         ; Move one column across.
 $E755 JR NZ,$E746   ; Jump to #R$E746 until this row is complete.
 $E757 DEC D         ; Move on to the next row of tiles.
 $E758 JR Z,$E75D    ; Jump to #R$E75D if every row is written.
 $E75A DEC B         ; Move one row up.
 $E75B JR $E73B      ; Jump to #R$E73B.
*$E75D POP HL        ; {Restore #REGhl, #REGde, #REGbc and #REGaf from the
 $E75E POP DE        ; stack.
 $E75F POP BC        ;
 $E760 POP AF        ; }
 $E761 RET           ; Return.

; Convert Coordinate To Buffer Offset
;
; Used by the routines at #R$E72F, #R$E787, #R$F001 and #R$F107.
; .
; Clone of #R$A86E used during play. Writes the offset to #R$F330.
;
;   B Vertical position
;   C Horizontal position
; O:HL Position in Room Buffer (also written to #R$F330)
;
; Convert a room column/ row into an offset in the room buffer.
@label=ConvertCoordinateToBufferOffset
c$E762 LD A,$18      ; {#REGe=#N$18-#REGb.
 $E764 SUB B         ;
 $E765 LD E,A        ; }
 $E766 LD D,$00      ; #REGd=#N$00.
 $E768 SLA E         ; {#REGde*=#N$20.
 $E76A RL D          ;
 $E76C SLA E         ;
 $E76E RL D          ;
 $E770 SLA E         ;
 $E772 RL D          ;
 $E774 SLA E         ;
 $E776 RL D          ;
 $E778 SLA E         ;
 $E77A RL D          ; }
 $E77C LD A,$21      ; {#REGl=#N$21-#REGc.
 $E77E SUB C         ;
 $E77F LD L,A        ; }
 $E780 LD H,$00      ; #REGh=#N$00.
 $E782 ADD HL,DE     ; #REGhl+=#REGde.
 $E783 LD ($F330),HL ; Write #REGhl to *#R$F330.
 $E786 RET           ; Return.

; Print Sprite/ Update Buffer
;
; Used by the routines at #R$E22D, #R$E3E0, #R$E47A, #R$E581 and #R$E9E2.
;
; A Sprite ID
; B Vertical position
; C Horizontal position
; D Height
; E Width
@label=PrintSpriteUpdateBuffer
c$E787 LD HL,($5C36) ; {Stash the current *#SKOOLKID$5C36(CHARS) on the stack.
 $E78A PUSH HL       ; }
 $E78B LD HL,$8378   ; {Write #R$8478(#N$8378) to *#SKOOLKID$5C36(CHARS).
 $E78E LD ($5C36),HL ; }
 $E791 LD A,E        ; {Write #REGe to *#R$F335.
 $E792 LD ($F335),A  ; }
@label=PrintSpriteUpdateBuffer_Loop
*$E795 LD A,($F335)  ; {Restore *#R$F335 back to #REGe.
 $E798 LD E,A        ; }
 $E799 PUSH BC       ; {Stash the co-ordinates and width/ height on the stack
 $E79A PUSH DE       ; temporarily.}
 $E79B CALL $E762    ; Call #R$E762.
 $E79E CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $E7A1 POP DE        ; {Restore the width/ height and the co-ordinates from the
 $E7A2 POP BC        ; stack.}
*$E7A3 PUSH DE       ; Stash #REGde on the stack.
 $E7A4 LD HL,($F330) ; {Increment *#R$F330 by one.
 $E7A7 INC HL        ;
 $E7A8 LD ($F330),HL ; }
 $E7AB DEC HL        ; Decrease #REGhl by one.
 $E7AC LD DE,$A1C4   ; {#REGhl+=#R$A1C4.
 $E7AF ADD HL,DE     ; }
 $E7B0 LD A,(HL)     ; #REGa=*#REGhl.
 $E7B1 POP DE        ; Restore #REGde from the stack.
 $E7B2 CP $00        ; {Jump to #R$E7BD if #REGa is not equal to #N$00.
 $E7B4 JR NZ,$E7BD   ; }
 $E7B6 LD A,$20      ; #REGa=#N$20.
 $E7B8 CALL $E6DC    ; Call #R$E6DC.
 $E7BB JR $E7D3      ; Jump to #R$E7D3.
*$E7BD PUSH AF       ; {Stash #REGaf and #REGaf on the stack.
 $E7BE PUSH AF       ; }
 $E7BF AND %10000000 ; Keep only bit 7.
 $E7C1 CALL NZ,$E7FB ; Call #R$E7FB if bit 7 is set.
 $E7C4 POP AF        ; Restore #REGaf from the stack.
 $E7C5 AND %01111111 ; Keep only bits 0-6.
 $E7C7 RST $10       ; Print to the screen using RST #SKOOLKID$0010(PRINT_A_1).
 $E7C8 POP AF        ; Restore #REGaf from the stack.
 $E7C9 JR Z,$E7D3    ; Jump to #R$E7D3 if bits 0-6 are zero.
 $E7CB PUSH HL       ; Stash #REGhl on the stack.
 $E7CC LD HL,$8378   ; {Write #R$8478(#N$8378) to *#SKOOLKID$5C36(CHARS).
 $E7CF LD ($5C36),HL ; }
 $E7D2 POP HL        ; Restore #REGhl from the stack.
*$E7D3 PUSH DE       ; {Stash #REGde and #REGhl on the stack.
 $E7D4 PUSH HL       ; }
 $E7D5 LD HL,($F330) ; #REGhl=*#R$F330.
 $E7D8 DEC HL        ; Decrease #REGhl by one.
 $E7D9 LD DE,$A4E4   ; {#REGhl+=#R$A4E4.
 $E7DC ADD HL,DE     ; }
 $E7DD LD A,(HL)     ; {Jump to #R$E7EB if *#REGhl is equal to #N$00.
 $E7DE CP $00        ;
 $E7E0 JR Z,$E7EB    ; }
 $E7E2 LD DE,$5800   ; #REGde=#N$5800 (attribute buffer location).
 $E7E5 LD HL,($F330) ; #REGhl=*#R$F330.
 $E7E8 DEC HL        ; Decrease #REGhl by one.
 $E7E9 ADD HL,DE     ; #REGhl+=#REGde.
 $E7EA LD (HL),A     ; Write #REGa to *#REGhl.
*$E7EB POP HL        ; {Restore #REGhl and #REGde from the stack.
 $E7EC POP DE        ; }
 $E7ED DEC E         ; Decrease #REGe by one.
 $E7EE JR NZ,$E7A3   ; Jump to #R$E7A3 until #REGe is zero.
 $E7F0 DEC D         ; Decrease #REGd by one.
 $E7F1 JR Z,$E7F6    ; Jump to #R$E7F6 if #REGd is zero.
 $E7F3 DEC B         ; Decrease #REGb by one.
 $E7F4 JR $E795      ; Jump to #R$E795.
@label=PrintSpriteUpdateBuffer_Housekeeping
*$E7F6 POP HL        ; {Restore the original value of *#SKOOLKID$5C36(CHARS)
 $E7F7 LD ($5C36),HL ; from the stack.}
 $E7FA RET           ; Return.
*$E7FB PUSH HL       ; Stash #REGhl on the stack.
 $E7FC LD HL,$8678   ; {Write #R$8778(#N$8678) to *#SKOOLKID$5C36(CHARS).
 $E7FF LD ($5C36),HL ; }
 $E802 POP HL        ; Restore #REGhl from the stack.
 $E803 RET           ; Return.

; Populate Game Room Buffer
;
; Used by the routines at #R$E72F and #R$F107.
; .
; Writes one tile and its attribute into the room buffers. Clone of
; #R$A893.
;
; A Tile ID to write
@label=PopulateGameRoomBuffer
c$E804 PUSH AF       ; {Stash #REGaf, #REGde and #REGhl on the stack.
 $E805 PUSH DE       ;
 $E806 PUSH HL       ; }
 $E807 LD HL,($F330) ; {Advance *#R$F330 past this tile.
 $E80A INC HL        ;
 $E80B LD ($F330),HL ; }
 $E80E DEC HL        ; Point back at the tile just claimed.
 $E80F LD DE,$A1C4   ; {Add the room-buffer base at #R$A1C4.
 $E812 ADD HL,DE     ; }
 $E813 LD (HL),A     ; Write the tile ID into the room buffer.
 $E814 LD DE,$0320   ; {Move on to the matching attribute byte.
 $E817 ADD HL,DE     ; }
 $E818 LD A,($5C8F)  ; #REGa=*#SKOOLKID$5C8F(ATTR_T).
 $E81B LD (HL),A     ; Write #REGa to *#REGhl.
 $E81C POP HL        ; {Restore #REGhl, #REGde and #REGaf from the stack.
 $E81D POP DE        ;
 $E81E POP AF        ; }
 $E81F RET           ; Return.

; Lift Collision Flag
;
; Set to #N$02 when a lift overlaps the player. See #R$E821 and
; #R$EBD8.
@label=FlagLiftCollision
g$E820 DEFB $00

; Handler: Lifts
;
; Used by the routine at #R$DEA8.
;
; .
;
; Only action lifts every other frame.
@label=Handler_Lifts
c$E821 LD A,($F334)    ; #REGa=*#R$F334 (lifts/ pirates frame skip).
 $E824 INC A           ; Increment #REGa by one.
 $E825 AND %00000001   ; Ensure #REGa is either #N$00 or #N$01.
 $E827 LD ($F334),A    ; Write #REGa back to *#R$F334.
 $E82A CP $01          ; {Return if this is a skipped frame.
 $E82C RET NZ          ; }
; Point the UDG graphics at the lift frames.
 $E82D LD HL,$F17B     ; {Write #R$F27B(#N$F17B) to *#SKOOLKID$5C36(CHARS).
 $E830 LD ($5C36),HL   ; }
; Walk the lift table.
 $E833 LD IX,($5BE4)   ; #REGix=*#R$5BE4.
; Walk each lift in *#R$5BE4.
@label=Handler_Lifts_Loop
*$E837 LD A,(IX+$00)   ; {Return if this lift entry is the terminator (#N$FF).
 $E83A CP $FF          ;
 $E83C RET Z           ; }
 $E83D LD A,(IX+$04)   ; {Jump to #R$E946 if this lift is not moving
 $E840 CP $00          ; horizontally.
 $E842 JP Z,$E946      ; }
; Test whether the player is standing on this lift.
 $E845 LD A,($F240)    ; {Jump to #R$E8B5 if the player's previous vertical offset
 $E848 CP $03          ; is not #N$03.
 $E84A JR NZ,$E8B5     ; }
 $E84C LD E,(IX+$07)   ; #REGe=the lift width.
 $E84F LD C,(IX+$00)   ; #REGc=the lift horizontal co-ordinate.
 $E852 LD B,(IX+$01)   ; #REGb=the lift vertical co-ordinate.
 $E855 LD A,($F23F)    ; #REGa=the player's previous vertical co-ordinate.
 $E858 SUB $03         ; Move up three rows to the player's feet.
 $E85A CP B            ; {Jump to #R$E8B5 if the player is not on this lift's
 $E85B JR NZ,$E8B5     ; row.}
 $E85D LD C,(IX+$00)   ; #REGc=the lift horizontal co-ordinate.
 $E860 LD B,(IX+$01)   ; #REGb=the lift vertical co-ordinate.
 $E863 PUSH BC         ; Stash the lift co-ordinates on the stack.
 $E864 CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E867 LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E86A POP BC          ; Restore the lift co-ordinates from the stack.
 $E86B INC B           ; Move one row down.
 $E86C PUSH HL         ; Stash the first screen address on the stack.
 $E86D CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E870 POP HL          ; Restore the first screen address from the stack.
 $E871 LD DE,($5C84)   ; #REGde=*#SKOOLKID$5C84(DF_CC).
 $E875 LD A,D          ; {Move #REGde down seven pixel rows.
 $E876 ADD A,$07       ;
 $E878 LD D,A          ; }
 $E879 LD B,(IX+$07)   ; #REGb=the lift width.
 $E87C LD A,(IX+$02)   ; {Jump to #R$E884 if the lift horizontal offset is higher
 $E87F CP $02          ; than #N$02.
 $E881 JR NC,$E884     ; }
 $E883 INC B           ; Widen the overlap test by one.
*$E884 LD A,(DE)       ; #REGa=a byte from the lower scanline.
 $E885 AND (HL)        ; AND it with the matching byte from the lift.
 $E886 JR NZ,$E88E     ; Jump to #R$E88E if the player overlaps this lift.
 $E888 INC HL          ; Advance the lift screen pointer.
 $E889 INC DE          ; Advance the player screen pointer.
 $E88A DJNZ $E884      ; Decrease counter by one and loop back to #R$E884 until the
                       ; whole lift width has been tested.
 $E88C JR $E8B5        ; Jump to #R$E8B5.
*$E88E LD A,$02        ; {Set *#R$E820; the player is on this lift.
 $E890 LD ($E820),A    ; }
 $E893 LD A,(IX+$04)   ; {Jump to #R$E8A4 if this lift is not moving
 $E896 CP $00          ; horizontally.
 $E898 JR Z,$E8A4      ; }
 $E89A CP $FF          ; Compare the overlap byte with #N$FF.
 $E89C PUSH AF         ; Stash #REGaf on the stack.
 $E89D CALL Z,$E92E    ; Nudge the player right if the overlap is solid.
 $E8A0 POP AF          ; Restore #REGaf from the stack.
 $E8A1 CALL NZ,$E926   ; Nudge the player left if the overlap is not solid.
*$E8A4 LD A,(IX+$05)   ; {Jump to #R$E8B5 if this lift is not moving
 $E8A7 CP $00          ; vertically.
 $E8A9 JR Z,$E8B5      ; }
 $E8AB CP $FF          ; Compare the overlap byte with #N$FF.
 $E8AD PUSH AF         ; Stash #REGaf on the stack.
 $E8AE CALL Z,$E93E    ; Nudge the player down if the overlap is solid.
 $E8B1 POP AF          ; Restore #REGaf from the stack.
 $E8B2 CALL NZ,$E936   ; Nudge the player up if the overlap is not solid.
@label=Handler_Lifts_Next
*$E8B5 CALL $EEA6      ; Apply this lift's movement deltas.
 $E8B8 LD A,(IX+$04)   ; {Test whether the lift is moving horizontally.
 $E8BB CP $00          ; }
 $E8BD PUSH AF         ; Stash #REGaf on the stack.
 $E8BE CALL Z,$E901    ; Reverse or clamp horizontal travel if it is
                       ; stationary.
 $E8C1 POP AF          ; Restore #REGaf from the stack.
 $E8C2 CALL NZ,$E8DC   ; Reverse or clamp horizontal travel if it is moving.
 $E8C5 LD (IX+$00),C   ; Write the new horizontal co-ordinate back to the lift.
 $E8C8 LD (IX+$01),B   ; Write the new vertical co-ordinate back to the lift.
 $E8CB LD (IX+$02),E   ; Write the new horizontal offset back to the lift.
 $E8CE LD (IX+$03),D   ; Write the new vertical offset back to the lift.
 $E8D1 CALL $EED7      ; Print the lift.
 $E8D4 LD DE,$0010     ; {Move #REGix on to the next sixteen-byte lift entry.
 $E8D7 ADD IX,DE       ; }
 $E8D9 JP $E837        ; Jump to #R$E837.
; Reverse horizontal travel when the lift hits a bound.
*$E8DC LD A,(IX+$04)   ; {Jump to #R$E8F2 if the lift is moving right.
 $E8DF CP $FF          ;
 $E8E1 JR Z,$E8F2      ; }
 $E8E3 LD A,(IX+$0A)   ; {Return if the horizontal co-ordinate is not the left
 $E8E6 CP C            ; bound.
 $E8E7 RET NZ          ; }
 $E8E8 LD A,(IX+$0B)   ; {Return if the horizontal offset is not the left
 $E8EB CP E            ; bound.
 $E8EC RET NZ          ; }
 $E8ED LD (IX+$04),$FF ; Reverse horizontal movement to the right.
 $E8F1 RET             ; Return.
*$E8F2 LD A,(IX+$0C)   ; {Return if the horizontal co-ordinate is not the right
 $E8F5 CP C            ; bound.
 $E8F6 RET NZ          ; }
 $E8F7 LD A,(IX+$0D)   ; {Return if the horizontal offset is not the right
 $E8FA CP E            ; bound.
 $E8FB RET NZ          ; }
 $E8FC LD (IX+$04),$01 ; Reverse horizontal movement to the left.
 $E900 RET             ; Return.
; Reverse vertical travel when the lift hits a bound.
*$E901 LD A,(IX+$05)   ; {Jump to #R$E917 if the lift is moving down.
 $E904 CP $FF          ;
 $E906 JR Z,$E917      ; }
 $E908 LD A,(IX+$0A)   ; {Return if the vertical co-ordinate is not the top
 $E90B CP B            ; bound.
 $E90C RET NZ          ; }
 $E90D LD A,(IX+$0B)   ; {Return if the vertical offset is not the top bound.
 $E910 CP D            ;
 $E911 RET NZ          ; }
 $E912 LD (IX+$05),$FF ; Reverse vertical movement to down.
 $E916 RET             ; Return.
*$E917 LD A,(IX+$0C)   ; {Return if the vertical co-ordinate is not the bottom
 $E91A CP B            ; bound.
 $E91B RET NZ          ; }
 $E91C LD A,(IX+$0D)   ; {Return if the vertical offset is not the bottom
 $E91F CP D            ; bound.
 $E920 RET NZ          ; }
 $E921 LD (IX+$05),$01 ; Reverse vertical movement to up.
 $E925 RET             ; Return.
*$E926 LD A,($F235)    ; {Nudge the player's horizontal movement left.
 $E929 INC A           ;
 $E92A LD ($F235),A    ; }
 $E92D RET             ; Return.
*$E92E LD A,($F235)    ; {Nudge the player's horizontal movement right.
 $E931 DEC A           ;
 $E932 LD ($F235),A    ; }
 $E935 RET             ; Return.
*$E936 LD A,($F236)    ; {Nudge the player's vertical movement up.
 $E939 INC A           ;
 $E93A LD ($F236),A    ; }
 $E93D RET             ; Return.
*$E93E LD A,($F236)    ; {Nudge the player's vertical movement down.
 $E941 DEC A           ;
 $E942 LD ($F236),A    ; }
 $E945 RET             ; Return.
; Stationary lift: still test whether the player is standing on it.
*$E946 LD A,($F240)    ; #REGa=the player's previous vertical offset.
 $E949 INC A           ; Increment #REGa by one.
 $E94A AND %00000011   ; Keep only bits 0-1.
 $E94C CP (IX+$03)     ; {Jump to #R$E8B5 if #REGa is not equal to
 $E94F JP NZ,$E8B5     ; *#REGix+#N$03.}
 $E952 LD C,(IX+$00)   ; #REGc=*#REGix+#N$00.
 $E955 LD B,(IX+$01)   ; #REGb=*#REGix+#N$01.
 $E958 LD A,(IX+$03)   ; #REGa=*#REGix+#N$03.
 $E95B CP $00          ; Compare #REGa with #N$00.
 $E95D LD A,($F23F)    ; #REGa=*#R$F23F.
 $E960 JR Z,$E963      ; Jump to #R$E963 if #REGa was equal to #N$00 on line
                       ; #R$E95B.
 $E962 DEC A           ; Decrease #REGa by one.
*$E963 SUB $02         ; #REGa-=#N$02.
 $E965 CP B            ; {Jump to #R$E8B5 if #REGa is not equal to #REGb.
 $E966 JP NZ,$E8B5     ; }
 $E969 LD A,(IX+$03)   ; #REGa=*#REGix+#N$03.
 $E96C LD C,(IX+$00)   ; #REGc=*#REGix+#N$00.
 $E96F LD B,(IX+$01)   ; #REGb=*#REGix+#N$01.
 $E972 PUSH AF         ; Stash #REGaf on the stack.
 $E973 CP $03          ; {Call #R$E9B7 if #REGa is equal to #N$03.
 $E975 CALL Z,$E9B7    ; }
 $E978 POP AF          ; Restore #REGaf from the stack.
 $E979 PUSH AF         ; Stash #REGaf on the stack.
 $E97A CP $02          ; {Call #R$E9AA if #REGa is equal to #N$02.
 $E97C CALL Z,$E9AA    ; }
 $E97F POP AF          ; Restore #REGaf from the stack.
 $E980 PUSH AF         ; Stash #REGaf on the stack.
 $E981 CP $01          ; {Call #R$E99B if #REGa is equal to #N$01.
 $E983 CALL Z,$E99B    ; }
 $E986 POP AF          ; Restore #REGaf from the stack.
 $E987 CP $00          ; {Call #R$E9C2 if #REGa is equal to #N$00.
 $E989 CALL Z,$E9C2    ; }
 $E98C LD B,(IX+$07)   ; #REGb=*#REGix+#N$07.
*$E98F LD A,(DE)       ; #REGa=*#REGde.
 $E990 AND (HL)        ; Merge the bits from *#REGhl.
 $E991 JP NZ,$E88E     ; Jump to #R$E88E if the result is not zero.
 $E994 INC HL          ; Increment #REGhl by one.
 $E995 INC DE          ; Increment #REGde by one.
 $E996 DJNZ $E98F      ; Decrease counter by one and loop back to #R$E98F until
                       ; counter is zero.
 $E998 JP $E8B5        ; Jump to #R$E8B5.
*$E99B CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E99E LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E9A1 INC H           ; {Increment #REGh by five.
 $E9A2 INC H           ;
 $E9A3 INC H           ;
 $E9A4 INC H           ;
 $E9A5 INC H           ; }
 $E9A6 PUSH HL         ; {#REGde=#REGhl (using the stack).
 $E9A7 POP DE          ; }
 $E9A8 INC H           ; Increment #REGh by one.
 $E9A9 RET             ; Return.
*$E9AA CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E9AD LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E9B0 INC H           ; {Increment #REGh by three.
 $E9B1 INC H           ;
 $E9B2 INC H           ; }
 $E9B3 PUSH HL         ; {#REGde=#REGhl (using the stack).
 $E9B4 POP DE          ; }
 $E9B5 INC H           ; Increment #REGh by one.
 $E9B6 RET             ; Return.
*$E9B7 CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E9BA LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E9BD INC H           ; Increment #REGh by one.
 $E9BE PUSH HL         ; {#REGde=#REGhl (using the stack).
 $E9BF POP DE          ; }
 $E9C0 INC H           ; Increment #REGh by one.
 $E9C1 RET             ; Return.
*$E9C2 PUSH BC         ; Stash #REGbc on the stack.
 $E9C3 CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E9C6 POP BC          ; Restore #REGbc from the stack.
 $E9C7 LD DE,($5C84)   ; #REGde=*#SKOOLKID$5C84(DF_CC).
 $E9CB LD A,D          ; {#REGd+=#N$07.
 $E9CC ADD A,$07       ;
 $E9CE LD D,A          ; }
 $E9CF PUSH DE         ; Stash #REGde on the stack.
 $E9D0 DEC B           ; Decrease #REGb by one.
 $E9D1 CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $E9D4 POP DE          ; Restore #REGde from the stack.
 $E9D5 LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $E9D8 RET             ; Return.

; In-Game Pause
;
; Used by the routines at #R$DEA8 and #R$ED35.
@label=InGamePause
c$E9D9 LD BC,$07D0   ; #REGbc=#N$07D0.
@label=InGamePause_Loop
*$E9DC DEC BC        ; Decrease #REGbc by one.
 $E9DD LD A,B        ; {Jump to #R$E9DC until #REGbc is zero.
 $E9DE OR C          ;
 $E9DF JR NZ,$E9DC   ; }
 $E9E1 RET           ; Return.

; Erase Sprite Trail
;
; Used by the routines at #R$EBD8 and #R$F001.
; .
; Clears the character-wide strip left behind when a sprite moves.
;
; IX Sprite data
; B Current vertical position
; C Current horizontal position
; D Current vertical offset
; E Current horizontal offset
@label=EraseSpriteTrail
c$E9E2 LD A,C        ; #REGa=#REGc.
 $E9E3 SUB (IX+$0D)  ; #REGa-=*#REGix+#N$0D.
 $E9E6 JR Z,$E9F4    ; Jump to #R$E9F4 if the result is zero.
 $E9E8 CP $FF        ; Compare #REGa with #N$FF.
 $E9EA PUSH AF       ; Stash #REGaf on the stack.
 $E9EB CALL Z,$EA1D  ; Call #R$EA1D if #REGa is equal to #N$FF.
 $E9EE POP AF        ; Restore #REGaf from the stack.
 $E9EF CALL NZ,$EA38 ; Call #R$EA38 if #REGa is not equal to #N$FF.
 $E9F2 JR $E9FF      ; Jump to #R$E9FF.
*$E9F4 LD A,E        ; {Jump to #R$E9FF if #REGe is equal to *#REGix+#N$0B.
 $E9F5 CP (IX+$0B)   ;
 $E9F8 JR Z,$E9FF    ; }
 $E9FA CP $03        ; {Call #R$EA38 if #REGe is equal to #N$03.
 $E9FC CALL Z,$EA38  ; }
*$E9FF LD A,B        ; #REGa=#REGb.
 $EA00 SUB (IX+$0E)  ; #REGa-=*#REGix+#N$0E.
 $EA03 JR Z,$EA11    ; Jump to #R$EA11 if the result is zero.
 $EA05 CP $FF        ; Compare #REGa with #N$FF.
 $EA07 PUSH AF       ; Stash #REGaf on the stack.
 $EA08 CALL Z,$EA78  ; Call #R$EA78 if #REGa was equal to #N$FF (on line
                     ; #R$EA05).
 $EA0B POP AF        ; Restore #REGaf from the stack.
 $EA0C CALL NZ,$EA58 ; Call #R$EA58 if #REGa was not equal to #N$FF (on line
                     ; #R$EA05).
 $EA0F JR $EA1C      ; Jump to #R$EA1C.
*$EA11 LD A,D        ; {Jump to #R$EA1C if #REGd is equal to *#REGix+#N$0F.
 $EA12 CP (IX+$0F)   ;
 $EA15 JR Z,$EA1C    ; }
 $EA17 CP $03        ; {Call #R$EA58 if #REGd is equal to #N$03.
 $EA19 CALL Z,$EA58  ; }
*$EA1C RET           ; Return.
*$EA1D PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $EA1E PUSH DE       ; }
 $EA1F LD C,(IX+$0D) ; #REGc=*#REGix+#N$0D.
 $EA22 LD B,(IX+$0E) ; #REGb=*#REGix+#N$0E.
 $EA25 LD D,(IX+$08) ; #REGd=*#REGix+#N$08.
 $EA28 LD E,$01      ; #REGe=#N$01.
 $EA2A LD A,(IX+$0F) ; {Jump to #R$EA32 if *#REGix+#N$0F is equal to #N$03.
 $EA2D CP $03        ;
 $EA2F JR Z,$EA32    ; }
 $EA31 INC D         ; Increment #REGd by one.
*$EA32 CALL $E787    ; Call #R$E787.
 $EA35 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $EA36 POP BC        ; }
 $EA37 RET           ; Return.
*$EA38 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $EA39 PUSH DE       ; }
 $EA3A LD A,(IX+$0D) ; #REGa=*#REGix+#N$0D.
 $EA3D LD C,(IX+$07) ; #REGc=*#REGix+#N$07.
 $EA40 SUB C         ; #REGa-=#REGc.
 $EA41 LD C,A        ; #REGc=#REGa.
 $EA42 LD B,(IX+$0E) ; #REGb=*#REGix+#N$0E.
 $EA45 LD D,(IX+$08) ; #REGd=*#REGix+#N$08.
 $EA48 LD E,$01      ; #REGe=#N$01.
 $EA4A LD A,(IX+$03) ; {Jump to #R$EA52 if *#REGix+#N$03 is equal to #N$03.
 $EA4D CP $03        ;
 $EA4F JR Z,$EA52    ; }
 $EA51 INC D         ; Increment #REGd by one.
*$EA52 CALL $E787    ; Call #R$E787.
 $EA55 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $EA56 POP BC        ; }
 $EA57 RET           ; Return.
*$EA58 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $EA59 PUSH DE       ; }
 $EA5A LD A,(IX+$0E) ; #REGa=*#REGix+#N$0E.
 $EA5D LD D,(IX+$08) ; #REGd=*#REGix+#N$08.
 $EA60 SUB D         ; #REGa-=#REGd.
 $EA61 LD B,A        ; #REGb=#REGa.
 $EA62 LD E,(IX+$07) ; #REGe=*#REGix+#N$07.
 $EA65 LD C,(IX+$0D) ; #REGc=*#REGix+#N$0D.
 $EA68 LD D,$01      ; #REGd=#N$01.
 $EA6A LD A,(IX+$02) ; {Jump to #R$EA72 if *#REGix+#N$02 is equal to #N$03.
 $EA6D CP $03        ;
 $EA6F JR Z,$EA72    ; }
 $EA71 INC E         ; Increment #REGe by one.
*$EA72 CALL $E787    ; Call #R$E787.
 $EA75 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $EA76 POP BC        ; }
 $EA77 RET           ; Return.
*$EA78 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $EA79 PUSH DE       ; }
 $EA7A LD C,(IX+$0D) ; #REGc=*#REGix+#N$0D.
 $EA7D LD B,(IX+$0E) ; #REGb=*#REGix+#N$0E.
 $EA80 LD D,$01      ; #REGd=#N$01.
 $EA82 LD E,(IX+$07) ; #REGe=*#REGix+#N$07.
 $EA85 LD A,(IX+$0B) ; {Jump to #R$EA8D if *#REGix+#N$0B is equal to #N$03.
 $EA88 CP $03        ;
 $EA8A JR Z,$EA8D    ; }
 $EA8C INC E         ; Increment #REGe by one.
*$EA8D CALL $E787    ; Call #R$E787.
 $EA90 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $EA91 POP BC        ; }
 $EA92 RET           ; Return.

; Print Sprite
;
; Used by the routines at #R$DFD3, #R$E3E0, #R$E47A, #R$E581, #R$E5F4, #R$EB8D,
; #R$F107 and #R$F1FC.
;
; A Sprite ID
; B Vertical co-ordinate
; C Horizontal co-ordinate
; D Height (in character blocks)
; E Width (in character blocks)
@label=PrintSprite
c$EA93 PUSH HL       ; Stash #REGhl on the stack.
 $EA94 DEC A         ; Decrease #REGa by one.
 $EA95 LD ($F336),A  ; Write #REGa to *#R$F336.
 $EA98 LD A,E        ; {Write #REGe to *#R$F335.
 $EA99 LD ($F335),A  ; }
*$EA9C LD A,C        ; {Jump to #R$EACD if #REGc is lower than #N$02.
 $EA9D CP $02        ;
 $EA9F JP C,$EACD    ; }
 $EAA2 LD A,($F335)  ; {#REGe=*#R$F335.
 $EAA5 LD E,A        ; }
 $EAA6 LD A,C        ; {Jump to #R$EADE if #REGc is higher than #N$22.
 $EAA7 CP $22        ;
 $EAA9 JP NC,$EADE   ; }
*$EAAC PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $EAAD PUSH DE       ; }
 $EAAE CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $EAB1 POP DE        ; Restore #REGde from the stack.
*$EAB2 LD A,($F336)  ; {Increment *#R$F336 by one.
 $EAB5 INC A         ;
 $EAB6 LD ($F336),A  ; }
 $EAB9 CALL $E6DC    ; Call #R$E6DC.
 $EABC LD A,C        ; {Call #R$EACF if #REGc is equal to #N$02.
 $EABD CP $02        ;
 $EABF CALL Z,$EACF  ; }
 $EAC2 DEC C         ; Decrease #REGc by one.
 $EAC3 DEC E         ; Decrease #REGe by one.
 $EAC4 JR NZ,$EAB2   ; Jump to #R$EAB2 until #REGe is zero.
 $EAC6 POP BC        ; Restore #REGbc from the stack.
 $EAC7 DEC D         ; Decrease #REGd by one.
 $EAC8 JR Z,$EACD    ; Jump to #R$EACD if #REGd is zero.
 $EACA DEC B         ; Decrease #REGb by one.
 $EACB JR $EA9C      ; Jump to #R$EA9C.
*$EACD POP HL        ; Restore #REGhl from the stack.
 $EACE RET           ; Return.
*$EACF DEC E         ; Decrease #REGe by one.
 $EAD0 PUSH AF       ; Stash #REGaf on the stack.
 $EAD1 INC E         ; Increment #REGe by one.
 $EAD2 LD A,($F336)  ; {Increment *#R$F336 by one.
 $EAD5 INC A         ;
 $EAD6 LD ($F336),A  ; }
 $EAD9 POP AF        ; Restore #REGaf from the stack.
 $EADA RET Z         ; Return if *#R$F336 is zero.
 $EADB DEC E         ; Decrease #REGe by one.
 $EADC JR $EACF      ; Jump to #R$EACF.
*$EADE LD A,($F336)  ; {Increment *#R$F336 by one.
 $EAE1 INC A         ;
 $EAE2 LD ($F336),A  ; }
 $EAE5 DEC E         ; Decrease #REGe by one.
 $EAE6 JP Z,$EACD    ; Jump to #R$EACD if #REGe is zero.
 $EAE9 DEC C         ; Decrease #REGc by one.
 $EAEA LD A,C        ; {Jump to #R$EAAC if #REGc is higher than #N$22.
 $EAEB CP $22        ;
 $EAED JR NC,$EAAC   ; }
 $EAEF JR $EADE      ; Jump to #R$EADE.
 $EAF1 LD B,$18      ; {Clear the bottom #N$18 lines using
 $EAF3 CALL $0E44    ; #SKOOLKID$0E44(CL_LINE).}
 $EAF6 LD BC,$0640   ; #REGbc=#N$0640.
 $EAF9 LD HL,$A1C4   ; #REGhl=#R$A1C4.
*$EAFC XOR A         ; {Write #N$00 to *#REGhl.
 $EAFD LD (HL),A     ; }
 $EAFE INC HL        ; Increment #REGhl by one.
 $EAFF DEC BC        ; Decrease #REGbc by one.
 $EB00 LD A,B        ; {Jump to #R$EAFC until #REGbc is zero.
 $EB01 OR C          ;
 $EB02 JR NZ,$EAFC   ; }
 $EB04 RET           ; Return.

; Player: Move Right
;
; Used by the routines at #R$E30B and #R$ED35.
;
; IX On entry will be set to #R$F231
@label=PlayerMoveRight
c$EB05 LD A,(IX+$11)   ; {Return if *#R$F242 is blocked / no walk.
 $EB08 CP $02          ;
 $EB0A RET Z           ; }
 $EB0B CP $03          ; {Jump to #R$EB26 if *#R$F242 is not on a ladder.
 $EB0D JR NZ,$EB26     ; }
 $EB0F LD A,(IX+$03)   ; {Return if *#R$F234 is not #N$03.
 $EB12 CP $03          ;
 $EB14 RET NZ          ; }
 $EB15 LD A,$FF        ; {Force *#R$F32D so the middle foot does not see a
 $EB17 LD ($F32D),A    ; floor.}
 $EB1A LD A,(IX+$01)   ; {Jump to #R$EB26 if *#R$F232 is at the top of the
 $EB1D CP (IX+$12)     ; ladder.
 $EB20 JR Z,$EB26      ; }
 $EB22 CP (IX+$13)     ; {Return if *#R$F232 is not at the bottom of the
 $EB25 RET NZ          ; ladder.}
; Face and walk right.
*$EB26 LD A,(IX+$11)   ; {Jump to #R$EB35 if *#R$F242 is already facing right.
 $EB29 CP $13          ;
 $EB2B JR Z,$EB35      ; }
 $EB2D LD (IX+$11),$13 ; Set *#R$F242 to facing right.
 $EB31 LD (IX+$06),$1A ; Write the frame before the first right-facing walk
                       ; sprite to *#R$F237.
*$EB35 LD A,(IX+$06)   ; #REGa=*#R$F237.
 $EB38 ADD A,$06       ; Advance to the next right-facing walk frame.
 $EB3A LD (IX+$06),A   ; Write it back to *#R$F237.
 $EB3D CP $50          ; {Jump to #R$EB45 if the walk cycle has not wrapped.
 $EB3F JR NZ,$EB45     ; }
 $EB41 LD (IX+$06),$20 ; Reset *#R$F237 to the first right-facing frame.
*$EB45 DEC (IX+$04)    ; Set *#R$F235 to move right.
 $EB48 RET             ; Return.

; Player: Move Left
;
; Used by the routines at #R$E30B and #R$ED35.
;
; IX On entry will be set to #R$F231
@label=PlayerMoveLeft
c$EB49 LD A,(IX+$11)   ; {Return if *#R$F242 is blocked / no walk.
 $EB4C CP $02          ;
 $EB4E RET Z           ; }
 $EB4F CP $03          ; {Jump to #R$EB6A if *#R$F242 is not on a ladder.
 $EB51 JR NZ,$EB6A     ; }
 $EB53 LD A,(IX+$03)   ; {Return if *#R$F234 is not #N$03.
 $EB56 CP $03          ;
 $EB58 RET NZ          ; }
 $EB59 LD A,$FF        ; {Force *#R$F32D so the middle foot does not see a
 $EB5B LD ($F32D),A    ; floor.}
 $EB5E LD A,(IX+$01)   ; {Jump to #R$EB6A if *#R$F232 is at the top of the
 $EB61 CP (IX+$12)     ; ladder.
 $EB64 JR Z,$EB6A      ; }
 $EB66 CP (IX+$13)     ; {Return if *#R$F232 is not at the bottom of the
 $EB69 RET NZ          ; ladder.}
; Face and walk left.
*$EB6A LD A,(IX+$11)   ; {Jump to #R$EB79 if *#R$F242 is already facing left.
 $EB6D CP $04          ;
 $EB6F JR Z,$EB79      ; }
 $EB71 LD (IX+$11),$04 ; Set *#R$F242 to facing left.
 $EB75 LD (IX+$06),$4A ; Write the frame before the first left-facing walk
                       ; sprite to *#R$F237.
*$EB79 LD A,(IX+$06)   ; #REGa=*#R$F237.
 $EB7C ADD A,$06       ; Advance to the next left-facing walk frame.
 $EB7E LD (IX+$06),A   ; Write it back to *#R$F237.
 $EB81 CP $80          ; {Jump to #R$EB89 if the walk cycle has not wrapped.
 $EB83 JR NZ,$EB89     ; }
 $EB85 LD (IX+$06),$50 ; Reset *#R$F237 to the first left-facing frame.
*$EB89 INC (IX+$04)    ; Set *#R$F235 to move left.
 $EB8C RET             ; Return.

; Handler: Unlock Door
;
; Used by the routine at #R$EBD8.
; .
; Opens the door at #REGhl, plays the unlock sound, and blanks the
; locked-door graphic.
@label=Handler_UnlockDoor
c$EB8D LD A,$05        ; {Queue the unlocked-door sound at #R$FFFE.
 $EB8F LD ($FFFE),A    ; }
 $EB92 PUSH IX         ; Stash the player slot on the stack.
 $EB94 PUSH HL         ; {Point #REGix at the matching door entry.
 $EB95 POP IX          ; }
 $EB97 PUSH BC         ; {Stash #REGbc and #REGde on the stack.
 $EB98 PUSH DE         ; }
 $EB99 LD C,(IX+$00)   ; #REGc=the door horizontal co-ordinate.
 $EB9C LD B,(IX+$01)   ; #REGb=the door vertical co-ordinate.
 $EB9F DEC B           ; Move one row up to the top of the door.
 $EBA0 LD (IX+$05),$00 ; Mark this door as open.
 $EBA4 PUSH BC         ; Stash the door co-ordinates on the stack.
 $EBA5 PUSH IX         ; Stash the door entry on the stack.
 $EBA7 LD DE,$0032     ; #REGde=#N($0032,$04,$04) (beeper pitch).
 $EBAA LD HL,$00C8     ; #REGhl=#N($00C8,$04,$04) (beeper duration).
; #HTML(#AUDIO0(unlocked-door-beep.wav)(#INCLUDE(UnlockedDoorBeep)))
 $EBAD CALL $03B5      ; Call #SKOOLKID$03B5(BEEPER).
 $EBB0 POP IX          ; Restore the door entry from the stack.
 $EBB2 POP BC          ; Restore the door co-ordinates from the stack.
 $EBB3 LD HL,($5C36)   ; {Stash *#SKOOLKID$5C36(CHARS) on the stack.
 $EBB6 PUSH HL         ; }
; Blank the locked-door graphic with empty mask tiles.
 $EBB7 LD HL,$9F6C     ; {Write #R$A06C(#N$9F6C) to *#SKOOLKID$5C36(CHARS).
 $EBBA LD ($5C36),HL   ; }
 $EBBD LD D,$04        ; {Set the blank width/ height to #N$01/ #N$04.
 $EBBF LD E,$01        ; }
 $EBC1 LD A,$00        ; #REGa=#N$00 (first mask tile).
 $EBC3 CALL $E72F      ; Erase the door from the room buffer.
 $EBC6 LD A,$20        ; #REGa=#N$20 (space).
 $EBC8 CALL $EA93      ; Print the blank door space.
 $EBCB POP HL          ; {Restore the previous value of *#SKOOLKID$5C36(CHARS) from the
 $EBCC LD ($5C36),HL   ; stack.}
 $EBCF POP DE          ; {Restore #REGde, #REGbc and the player slot from the
 $EBD0 POP BC          ; stack.
 $EBD1 POP IX          ; }
 $EBD3 LD (IX+$10),$00 ; Clear the key the player was holding.
 $EBD7 RET             ; Return.

; Handler: Player
;
; Used by the routine at #R$DEA8.
; .
; Walks the player, tests the floor under their feet, unlocks
; matching doors, and starts a fall if they step off.
@label=Handler_Player
c$EBD8 LD IX,$F231     ; Point #REGix at #R$F231.
 $EBDC LD A,$10        ; {Set INK: CYAN (#N$05).
 $EBDE RST $10         ;
 $EBDF LD A,$05        ;
 $EBE1 RST $10         ; }
 $EBE2 XOR A           ; {Clear *#R$F32F for this frame.
 $EBE3 LD ($F32F),A    ; }
; Skip the floor test while on a lift, on a ladder, or moving
; vertically.
 $EBE6 LD A,($E820)    ; {Jump to #R$EC49 if *#R$E820 shows a lift overlap.
 $EBE9 CP $00          ;
 $EBEB JR NZ,$EC49     ; }
 $EBED LD A,(IX+$11)   ; {Jump to #R$EC49 if *#R$F242 is on a ladder.
 $EBF0 CP $03          ;
 $EBF2 JR Z,$EC49      ; }
 $EBF4 LD A,(IX+$05)   ; {Jump to #R$EC49 if *#R$F236 is moving vertically.
 $EBF7 CP $00          ;
 $EBF9 JR NZ,$EC49     ; }
 $EBFB LD A,(IX+$03)   ; {Jump to #R$EC3D if *#R$F234 is not #N$03
 $EBFE CP $03          ; (not standing on a character row).
 $EC00 JP NZ,$EC3D     ; }
; Only test for a floor on the five walkable row bands.
 $EC03 LD A,(IX+$01)   ; {Jump to #R$EC1A if *#R$F232 is #N$1A.
 $EC06 CP $1A          ;
 $EC08 JR Z,$EC1A      ; }
 $EC0A CP $15          ; {Jump to #R$EC1A if *#R$F232 is #N$15.
 $EC0C JR Z,$EC1A      ; }
 $EC0E CP $10          ; {Jump to #R$EC1A if *#R$F232 is #N$10.
 $EC10 JR Z,$EC1A      ; }
 $EC12 CP $0B          ; {Jump to #R$EC1A if *#R$F232 is #N$0B.
 $EC14 JR Z,$EC1A      ; }
 $EC16 CP $06          ; {Jump to #R$EC3D if *#R$F232 is not #N$06.
 $EC18 JR NZ,$EC3D     ; }
; AND the walk masks with the three screen bytes under the
; player's feet.
*$EC1A LD C,(IX+$00)   ; #REGc=*#R$F231.
 $EC1D LD B,(IX+$01)   ; #REGb=*#R$F232.
 $EC20 DEC B           ; {Move up three rows to the feet.
 $EC21 DEC B           ;
 $EC22 DEC B           ; }
 $EC23 CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $EC26 LD HL,($5C84)   ; #REGhl=*#SKOOLKID$5C84(DF_CC).
 $EC29 LD A,($F32C)    ; Fetch the left foot mask from *#R$F32C.
 $EC2C AND (HL)        ; AND it with the left foot pixels.
 $EC2D JR NZ,$EC49     ; Jump to #R$EC49 if those pixels are solid.
 $EC2F INC HL          ; Advance to the middle foot column.
 $EC30 LD A,($F32D)    ; Fetch the middle foot mask from *#R$F32D.
 $EC33 AND (HL)        ; AND it with the middle foot pixels.
 $EC34 JR NZ,$EC49     ; Jump to #R$EC49 if those pixels are solid.
 $EC36 INC HL          ; Advance to the right foot column.
 $EC37 LD A,($F32E)    ; Fetch the right foot mask from *#R$F32E.
 $EC3A AND (HL)        ; AND it with the right foot pixels.
 $EC3B JR NZ,$EC49     ; Jump to #R$EC49 if those pixels are solid.
; Nothing solid underfoot, so start counting a fall.
*$EC3D DEC (IX+$05)    ; Decrease *#R$F236 by one.
 $EC40 LD A,($F33A)    ; {Increment *#R$F33A while there is no floor.
 $EC43 INC A           ;
 $EC44 LD ($F33A),A    ; }
 $EC47 JR $EC59        ; Jump to #R$EC59.
; Floor (or lift/ ladder) is present.
*$EC49 LD A,($F33F)    ; Fetch *#R$F33F to see if the player has already
                       ; fallen.
 $EC4C LD ($FFFC),A    ; Copy it to *#R$FFFC.
 $EC4F CP $00          ; {Jump to #R$E3A4 if the player has already fallen.
 $EC51 JP NZ,$E3A4     ; }
 $EC54 LD A,$00        ; {Reset *#R$F33A; the player is on solid ground.
 $EC56 LD ($F33A),A    ; }
*$EC59 CALL $EEA6      ; Apply the player's movement deltas.
 $EC5C LD A,C          ; {Jump to #R$ED10 if the player walked off the right.
 $EC5D CP $22          ;
 $EC5F JP Z,$ED10      ; }
 $EC62 CP $03          ; {Jump to #R$ED10 if the player walked off the left.
 $EC64 JP Z,$ED10      ; }
 $EC67 LD A,B          ; {Jump to #R$ED10 if the player walked off the top.
 $EC68 CP $18          ;
 $EC6A JP Z,$ED10      ; }
 $EC6D CP $04          ; {Jump to #R$E3A4 if the player walked off the bottom.
 $EC6F JP Z,$E3A4      ; }
 $EC72 LD A,C          ; {Jump to #R$EC84 if *#R$F231 changed.
 $EC73 CP (IX+$00)     ;
 $EC76 JR NZ,$EC84     ; }
 $EC78 LD A,B          ; {Jump to #R$EC84 if *#R$F232 changed.
 $EC79 CP (IX+$01)     ;
 $EC7C JR NZ,$EC84     ; }
 $EC7E LD A,(IX+$03)   ; {Jump to #R$ECA5 if *#R$F234 did not change.
 $EC81 CP D            ;
 $EC82 JR Z,$ECA5      ; }
*$EC84 LD A,$01        ; {Set *#R$F32F so this walk step will reprint.
 $EC86 LD ($F32F),A    ; }
 $EC89 PUSH DE         ; {Stash the new position and offsets on the stack.
 $EC8A PUSH BC         ; }
 $EC8B LD A,(IX+$11)   ; {Jump to #R$EC94 if the player is not facing right.
 $EC8E CP $13          ;
 $EC90 JR NZ,$EC94     ; }
 $EC92 DEC C           ; {Adjust the test column when facing right.
 $EC93 DEC C           ; }
*$EC94 CALL $F1AF      ; Look for a key or locked door at this position.
 $EC97 POP BC          ; {Restore the new position and offsets from the stack.
 $EC98 POP DE          ; }
 $EC99 CP $FF          ; {Jump to #R$ECA5 if there is no door here.
 $EC9B JR Z,$ECA5      ; }
; See #POKE(walkthroughDoors,Walkthrough All Doors).
 $EC9D CP (IX+$10)     ; {Jump to #R$ED10 if the player is not holding this door's
 $ECA0 JR NZ,$ED10     ; key.}
 $ECA2 CALL $EB8D      ; Unlock the door.
*$ECA5 LD (IX+$00),C   ; Write the new horizontal co-ordinate to *#R$F231.
 $ECA8 LD (IX+$01),B   ; Write the new vertical co-ordinate to *#R$F232.
 $ECAB LD (IX+$02),E   ; Write the new horizontal offset to *#R$F233.
 $ECAE LD (IX+$03),D   ; Write the new vertical offset to *#R$F234.
 $ECB1 PUSH DE         ; Stash the offsets on the stack.
 $ECB2 CALL $E9E2      ; Erase the player's previous sprite.
 $ECB5 POP DE          ; Restore the offsets from the stack.
 $ECB6 LD (IX+$02),E   ; Write the horizontal offset back to *#R$F233.
 $ECB9 LD (IX+$03),D   ; Write the vertical offset back to *#R$F234.
 $ECBC LD A,($F33A)    ; {Call #R$ED19 if *#R$F33A shows the player has been
 $ECBF CP $08          ; stepping into air.
 $ECC1 CALL NC,$ED19   ; }
; Reprint the player and refresh the walk masks.
 $ECC4 LD HL,$8978     ; {Write #R$8A78(#N$8978) to *#SKOOLKID$5C36(CHARS).
 $ECC7 LD ($5C36),HL   ; }
 $ECCA CALL $EED7      ; Print the player.
 $ECCD LD A,($A10B)    ; {Copy the left walk mask from #R$A10B.
 $ECD0 LD ($F32C),A    ; }
 $ECD3 LD A,($A12B)    ; {Copy the middle walk mask from #R$A12B.
 $ECD6 LD ($F32D),A    ; }
 $ECD9 LD A,($A14B)    ; {Copy the right walk mask from #R$A14B.
 $ECDC LD ($F32E),A    ; }
 $ECDF LD A,(IX+$00)   ; {Copy the horizontal co-ordinate to the previous-horizontal
 $ECE2 LD (IX+$0D),A   ; slot.}
 $ECE5 LD A,(IX+$01)   ; {Copy the vertical co-ordinate to the previous-vertical
 $ECE8 LD (IX+$0E),A   ; slot.}
 $ECEB LD A,(IX+$03)   ; {Copy the vertical offset to the previous-vertical-offset
 $ECEE LD (IX+$0F),A   ; slot.}
 $ECF1 LD A,(IX+$02)   ; {Copy the horizontal offset to the previous-offset
 $ECF4 LD (IX+$0B),A   ; slot.}
 $ECF7 LD A,($F32F)    ; {Jump to #R$ED10 if *#R$F32F does not need a door
 $ECFA CP $00          ; check.
 $ECFC JR Z,$ED10      ; }
 $ECFE LD C,(IX+$00)   ; #REGc=the player's horizontal co-ordinate.
 $ED01 LD B,(IX+$01)   ; #REGb=the player's vertical co-ordinate.
 $ED04 LD A,(IX+$11)   ; {Jump to #R$ED0D if the player is not facing right.
 $ED07 CP $13          ;
 $ED09 JR NZ,$ED0D     ; }
 $ED0B DEC C           ; {Adjust the test column when facing right.
 $ED0C DEC C           ; }
*$ED0D CALL $F107      ; Handle any key or locked door at the player's feet.
; Clear this frame's movement.
*$ED10 LD (IX+$04),$00 ; Clear horizontal movement.
 $ED14 LD (IX+$05),$00 ; Clear vertical movement.
 $ED18 RET             ; Return.
; Player is falling; switch to the falling animation.
@label=Action_Falling
*$ED19 LD A,$01        ; {Set *#R$F33F; the player is falling.
 $ED1B LD ($F33F),A    ; }
 $ED1E LD (IX+$11),$02 ; Set the action state to blocked / no walk.
 $ED22 LD A,(IX+$06)   ; {Jump to #R$ED2F if the sprite is not already a falling
 $ED25 CP $9E          ; frame.
 $ED27 JR C,$ED2F      ; }
 $ED29 ADD A,$06       ; Advance to the next falling frame.
 $ED2B CP $B0          ; {Jump to #R$ED31 if the falling animation has not
 $ED2D JR NZ,$ED31     ; wrapped.}
@label=SetFallingSprite
*$ED2F LD A,$9E        ; Set #REGa to #R$8E68(#N$9E), the first frame of the
                       ; "falling" animation.
@label=SetPlayerSprite
*$ED31 LD (IX+$06),A   ; Write the frame to the player sprite ID.
 $ED34 RET             ; Return.

; Player Controls
;
; Used by the routine at #R$DEA8.
;
; .
;
; See #R$D579.
@label=PlayerControls
c$ED35 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $ED38 LD A,($5BF0)  ; {Jump to #R$ED46 if *#R$5BF0 is not demo mode.
 $ED3B CP $03        ;
 $ED3D JR NZ,$ED46   ; }
 $ED3F LD A,E        ; #REGa=the keypress.
 $ED40 CP $FF        ; {Return if no keys have been pressed.
 $ED42 RET Z         ; }
 $ED43 JP $ED8F      ; Jump to #R$ED8F.
; All player controls use the user-defined keys except Kempston.
@label=Check_PlayerControls
*$ED46 LD IX,$F231   ; Point #REGix at #R$F231.
 $ED4A LD A,E        ; #REGa=the keypress.
; Check against #R$5BEB.
 $ED4B LD HL,$5BEB   ; Check the first user-defined key at #R$5BEB.
 $ED4E CP (HL)       ; {Jump to #R$EB49 if "left" has been pressed.
 $ED4F JP Z,$EB49    ; }
; Check against #R$5BEC.
 $ED52 INC HL        ; Check the next user-defined key.
 $ED53 CP (HL)       ; {Jump to #R$EB05 if "right" has been pressed.
 $ED54 JP Z,$EB05    ; }
; Check against #R$5BED.
 $ED57 INC HL        ; Check the next user-defined key.
 $ED58 CP (HL)       ; {Jump to #R$EE08 if "up" has been pressed.
 $ED59 JP Z,$EE08    ; }
; Check against #R$5BEE.
 $ED5C INC HL        ; Check the next user-defined key.
 $ED5D CP (HL)       ; {Jump to #R$ED9A if "down" has been pressed.
 $ED5E JP Z,$ED9A    ; }
; Check against #R$5BEF.
 $ED61 INC HL        ; Check the next user-defined key.
 $ED62 CP (HL)       ; {Jump to #R$EE5B if "fire" has been pressed.
 $ED63 JP Z,$EE5B    ; }
; Toggle the music on/ off - I wish I knew this in 1984!
 $ED66 CP $10        ; {Jump to #R$ED7D if #REGa is equal to #N$10.
 $ED68 JP Z,$ED7D    ; }
; Was the game paused?
 $ED6B CP $22        ; {Return if #REGa is not equal to #N$22.
 $ED6D RET NZ        ; }
; Handle the game being paused.
 $ED6E DI            ; Disable interrupts.
@label=InGamePauseLoop
*$ED6F CALL $E9D9    ; Call #R$E9D9.
 $ED72 CALL $028E    ; Call #SKOOLKID$028E(KEY_SCAN).
 $ED75 LD A,E        ; {Jump to #R$ED6F if no keys have been pressed.
 $ED76 CP $FF        ;
 $ED78 JP Z,$ED6F    ; }
 $ED7B EI            ; Re-enable interrupts.
 $ED7C RET           ; Return.

; In-Game Toggle Music
;
; Used by the routine at #R$ED35.
;
; .
;
; A clone in functionality of #R$D5B0, just the check is the opposite way round
; and we return instead of jumping.
@label=InGame_ToggleMusic
c$ED7D LD A,($FFF8)  ; {Jump to #R$ED8A if *#R$FFF8 is equal to #N$01.
 $ED80 CP $01        ;
 $ED82 JR Z,$ED8A    ; }
 $ED84 LD A,$01      ; {Write ON (#N$01) to *#R$FFF8.
 $ED86 LD ($FFF8),A  ; }
 $ED89 RET           ; Return.
@label=ToggleMusicOff
*$ED8A XOR A         ; {Write OFF (#N$00) to *#R$FFF8.
 $ED8B LD ($FFF8),A  ; }
 $ED8E RET           ; Return.

; Restore Font And Sounds
;
; Used by the routines at #R$DEA8, #R$E30B, #R$E3A4 and #R$ED35.
; .
; Restores the ROM character set and clears the sound flags via
; #R$E058.
@label=RestoreFontAndSounds
c$ED8F POP BC        ; Restore #REGbc from the stack.
; Restore the default ZX Spectrum font.
 $ED90 LD HL,$3C00   ; {Write #SKOOLKID$3D00(CHARSET)-#N$100 to
 $ED93 LD ($5C36),HL ; *#SKOOLKID$5C36(CHARS).}
 $ED96 CALL $E058    ; Call #R$E058.
 $ED99 RET           ; Return.

; Handler: Ladders Descending
;
; Used by the routines at #R$E30B and #R$ED35.
;
; IX On entry will be set to #R$F231
@label=Handler_LaddersDescending
c$ED9A LD A,(IX+$11)   ; {Jump to #R$EDED if *#R$F242 is already on a ladder.
 $ED9D CP $03          ;
 $ED9F JR Z,$EDED      ; }
 $EDA1 LD C,(IX+$00)   ; #REGc=*#R$F231.
 $EDA4 LD B,(IX+$01)   ; #REGb=*#R$F232.
 $EDA7 LD HL,($5BD8)   ; #REGhl=*#R$5BD8.
@label=Handler_LaddersDescending_Loop
*$EDAA LD A,(HL)       ; {Return if this ladder entry is the terminator
 $EDAB CP $FF          ; (#N$FF).
 $EDAD RET Z           ; }
 $EDAE INC HL          ; Advance to the ladder vertical.
 $EDAF CP C            ; {Jump to #R$EDB5 if this ladder is in the player's
 $EDB0 JR Z,$EDB5      ; column.}
 $EDB2 INC HL          ; Advance to the next ladder entry.
 $EDB3 JR $EDAA        ; Jump to #R$EDAA.
@label=Action_LadderDescend
*$EDB5 LD A,(HL)       ; #REGa=the ladder vertical.
 $EDB6 DEC A           ; {Move two rows up for the bottom bound.
 $EDB7 DEC A           ; }
 $EDB8 LD (IX+$13),A   ; Write the lower ladder bound to *#R$F244.
 $EDBB ADD A,$05       ; Add #N$05 for the top bound.
 $EDBD LD (IX+$12),A   ; Write the upper ladder bound to *#R$F243.
 $EDC0 INC HL          ; Advance to the next ladder entry.
 $EDC1 SUB B           ; Compare that span with the player's vertical.
 $EDC2 CP $04          ; {Jump to #R$EDAA if the player is not on this ladder.
 $EDC4 JR NC,$EDAA     ; }
 $EDC6 LD A,(IX+$11)   ; {Jump to #R$EDD5 if *#R$F242 is already on a ladder.
 $EDC9 CP $03          ;
 $EDCB JR Z,$EDD5      ; }
; Write the frame before the climb-down sprite we actually
; want (#R$8D78(#N$80)) to *#R$F237.
; The next step adds #N$06, so the first drawn frame is correct.
 $EDCD LD (IX+$06),$7A ; Write #R$8D48(#N$7A) to *#R$F237.
 $EDD1 LD (IX+$11),$03 ; Set *#R$F242 to on a ladder.
@label=AnimateDescending
*$EDD5 LD A,(IX+$06)   ; {Advance *#R$F237 by one climb-down frame.
 $EDD8 ADD A,$06       ;
 $EDDA LD (IX+$06),A   ; }
 $EDDD CP $98          ; {Jump to #R$EDE5 if the climb-down frames have not
 $EDDF JR NZ,$EDE5     ; wrapped (frame #R$8E38(#N$98) begins the next animation).
                       ; }
; Reset the climbing-down player sprite to the first frame.
 $EDE1 LD (IX+$06),$80 ; Write #R$8D78(#N$80) to *#R$F237.
@label=SkipResetDescendingFrame
*$EDE5 DEC (IX+$05)    ; Set *#R$F236 to move down.
 $EDE8 LD (IX+$02),$03 ; Centre *#R$F233 on the ladder.
 $EDEC RET             ; Return.
; Already climbing down; stop at the bottom bound.
*$EDED LD A,(IX+$01)   ; {Jump to #R$EDD5 if *#R$F232 has not reached *#R$F244.
 $EDF0 CP (IX+$13)     ;
 $EDF3 JR NZ,$EDD5     ; }
 $EDF5 RET             ; Return.
; This entry point is used by the routine at #R$EE08.
; .
; Already climbing up; stop at the top bound.
*$EDF6 LD A,(IX+$12)   ; {Jump to #R$EE42 if *#R$F232 has not reached *#R$F243.
 $EDF9 LD B,A          ;
 $EDFA LD A,(IX+$01)   ;
 $EDFD CP B            ;
 $EDFE JR NZ,$EE42     ; }
 $EE00 LD A,(IX+$03)   ; {Jump to #R$EE42 if *#R$F234 is not #N$03.
 $EE03 CP $03          ;
 $EE05 JR NZ,$EE42     ; }
 $EE07 RET             ; Return.

; Handler: Ladders Ascending
;
; Used by the routines at #R$E30B and #R$ED35.
;
; IX On entry will be set to #R$F231
@label=Handler_LaddersAscending
c$EE08 LD A,(IX+$11)   ; {Jump to #R$EDF6 if *#R$F242 is already on a ladder.
 $EE0B CP $03          ;
 $EE0D JR Z,$EDF6      ; }
 $EE0F LD C,(IX+$00)   ; #REGc=*#R$F231.
 $EE12 LD B,(IX+$01)   ; #REGb=*#R$F232.
 $EE15 LD HL,($5BD8)   ; #REGhl=*#R$5BD8.
@label=Handler_LaddersAscending_Loop
*$EE18 LD A,(HL)       ; {Return if this ladder entry is the terminator
 $EE19 CP $FF          ; (#N$FF).
 $EE1B RET Z           ; }
 $EE1C INC HL          ; Advance to the ladder vertical.
 $EE1D CP C            ; {Jump to #R$EE23 if this ladder is in the player's
 $EE1E JR Z,$EE23      ; column.}
 $EE20 INC HL          ; Advance to the next ladder entry.
 $EE21 JR $EE18        ; Jump to #R$EE18.
@label=Action_LadderAscend
*$EE23 LD A,(HL)       ; #REGa=the ladder vertical.
 $EE24 INC HL          ; Advance past this ladder's vertical.
 $EE25 DEC A           ; {Move two rows up for the bottom bound.
 $EE26 DEC A           ; }
 $EE27 CP B            ; {Jump to #R$EE18 if the player is not at the foot of this
 $EE28 JR NZ,$EE18     ; ladder.}
 $EE2A LD (IX+$13),A   ; Write the lower ladder bound to *#R$F244.
 $EE2D ADD A,$05       ; Add #N$05 for the top bound.
 $EE2F LD (IX+$12),A   ; Write the upper ladder bound to *#R$F243.
 $EE32 INC HL          ; Advance to the next ladder entry.
 $EE33 LD A,(IX+$11)   ; {Jump to #R$EE42 if *#R$F242 is already on a ladder.
 $EE36 CP $03          ;
 $EE38 JR Z,$EE42      ; }
; Write the frame after the climb-up sprite we actually
; want (#R$8E08(#N$92)) to *#R$F237.
; The next step subtracts #N$06, so the first drawn frame is
; correct.
 $EE3A LD (IX+$06),$98 ; Write #R$8E38(#N$98) to *#R$F237.
 $EE3E LD (IX+$11),$03 ; Set *#R$F242 to on a ladder.
; This entry point is used by the routine at #R$ED9A.
@label=AnimateAscending
*$EE42 LD A,(IX+$06)   ; {Step *#R$F237 back by one climb-up frame.
 $EE45 SUB $06         ;
 $EE47 LD (IX+$06),A   ; }
 $EE4A CP $7A          ; {Jump to #R$EE52 if the climb-up frames have not
 $EE4C JR NZ,$EE52     ; wrapped (frame #R$8D48(#N$7A) begins the next animation).
                       ; }
; Reset the climbing-up player sprite to the first frame.
 $EE4E LD (IX+$06),$92 ; Write #R$8E08(#N$92) to *#R$F237.
@label=SkipResetAscendingFrame
*$EE52 LD (IX+$05),$01 ; Set *#R$F236 to move up.
 $EE56 LD (IX+$02),$03 ; Centre *#R$F233 on the ladder.
 $EE5A RET             ; Return.

; Handler: Doors
;
; Used by the routines at #R$E30B and #R$ED35.
@label=Handler_Doors
c$EE5B LD IX,($5BD6) ; Point #REGix at *#R$5BD6.
 $EE5F LD BC,($F231) ; #REGbc=*#R$F231 (player column and row).
; Walk the door table looking for one the player is standing in.
@label=Handler_Doors_Loop
*$EE63 LD A,(IX+$00) ; {Return if this door entry is the terminator (#N$FF).
 $EE66 CP $FF        ;
 $EE68 RET Z         ; }
; Simple collision detection.
 $EE69 SUB C         ; {Jump to #R$EE75 if the player is more than two columns
 $EE6A CP $02        ; from this door.
 $EE6C JR NC,$EE75   ; }
 $EE6E LD A,(IX+$01) ; {Jump to #R$EE7C if the player is on the row below this
 $EE71 DEC A         ; door.
 $EE72 CP B          ;
 $EE73 JR Z,$EE7C    ; }
; No match; try the next four-byte door entry.
@label=Handler_Doors_Next
*$EE75 LD DE,$0004   ; {Move #REGix on to the next door.
 $EE78 ADD IX,DE     ; }
 $EE7A JR $EE63      ; Jump to #R$EE63.
; We found a matching door. Check if it's the "bad door" (the
; CYAN door in #R$C4F4(room #10)); else change room.
@label=FoundDoorMatch
*$EE7C LD A,(IX+$03) ; {Call #R$E361 if this door's destination room is #N$15.
 $EE7F CP $15        ;
 $EE81 CALL Z,$E361  ; }
; This entry point is used by the routine at #R$DEA8.
@label=ChangeRoom
*$EE84 LD ($5BD3),A  ; Write the destination room to *#R$5BD3.
 $EE87 LD A,$00      ; {Write #N$00 to: #LIST
 $EE89 LD ($F241),A  ; { *#R$F241 }
 $EE8C LD ($F2DB),A  ; { *#R$F2DB }
 $EE8F LD ($E479),A  ; { *#R$E479 }
 $EE92 LD ($F31C),A  ; { *#R$F31C }
                     ; LIST#}
 $EE95 LD A,$01      ; {Set *#R$F242 to emerging from a door.
 $EE97 LD ($F242),A  ; }
; Write the front-facing player sprite to be the active frame.
; .
; This ensures the player appears to be emerging from the door.
 $EE9A LD A,$98      ; {Write #R$8E38(#N$98) to *#R$F237.
 $EE9C LD ($F237),A  ; }
; This also draws the new room to the screen.
 $EE9F CALL $E0A9    ; Call #R$E0A9.
 $EEA2 CALL $E058    ; Call #R$E058.
 $EEA5 RET           ; Return.

; Apply Movement Deltas
;
; Used by the routines at #R$E22D, #R$E821, #R$EBD8 and #R$F001.
; .
; Applies horizontal and vertical movement deltas. Clone of #R$D616.
;
;   IX Sprite data
; O:B Updated vertical position
; O:C Updated horizontal position
; O:D Updated vertical offset
; O:E Updated horizontal offset
;
; Fetch the current position and apply horizontal movement.
@label=ApplyMovementDeltas
c$EEA6 LD C,(IX+$00) ; #REGc=horizontal co-ordinate.
 $EEA9 LD B,(IX+$01) ; #REGb=vertical co-ordinate.
 $EEAC LD E,(IX+$02) ; #REGe=horizontal offset.
 $EEAF LD D,(IX+$03) ; #REGd=vertical offset.
 $EEB2 LD A,(IX+$04) ; #REGa=horizontal movement.
 $EEB5 ADD A,E       ; Add it to the horizontal offset.
 $EEB6 CP $80        ; {Jump to #R$EEC0 if the offset overflowed (moving
 $EEB8 JR NC,$EEC0   ; right).}
 $EEBA CP $04        ; {Jump to #R$EEC3 if the offset is still in-range.
 $EEBC JR C,$EEC3    ; }
 $EEBE INC C         ; {Step the horizontal co-ordinate two left, then...
 $EEBF INC C         ; }
*$EEC0 DEC C         ; ...one right, so a crossed boundary updates the column.
 $EEC1 AND %00000011 ; Keep the horizontal offset in the range #N$00-#N$03.
*$EEC3 LD E,A        ; #REGe=the updated horizontal offset.
; Apply vertical movement the same way.
 $EEC4 LD A,(IX+$05) ; #REGa=vertical movement.
 $EEC7 ADD A,D       ; Add it to the vertical offset.
 $EEC8 CP $80        ; {Jump to #R$EED2 if the offset overflowed (moving down).
 $EECA JR NC,$EED2   ; }
 $EECC CP $04        ; {Jump to #R$EED5 if the offset is still in-range.
 $EECE JR C,$EED5    ; }
 $EED0 INC B         ; {Step the vertical co-ordinate two up, then...
 $EED1 INC B         ; }
*$EED2 DEC B         ; ...one down, so a crossed boundary updates the row.
 $EED3 AND %00000011 ; Keep the vertical offset in the range #N$00-#N$03.
*$EED5 LD D,A        ; #REGd=the updated vertical offset.
 $EED6 RET           ; Return.

; Print Shifted Sprite
;
; Used by the routines at #R$E22D, #R$E821, #R$EBD8 and #R$F001.
; .
; Pixel-shifts a sprite into a working buffer and prints it. Clone of
; #R$D647.
;
; IX Sprite data
@label=PrintShiftedSprite
c$EED7 LD DE,$A0EC   ; #REGde=#R$A0EC (working shift buffer).
 $EEDA LD HL,$A06C   ; #REGhl=#R$A06C (blank source tiles).
 $EEDD LD BC,$0080   ; #REGbc=#N($0080,$04,$04).
 $EEE0 LDIR          ; Copy the blank tiles into the working shift buffer.
 $EEE2 LD A,$10      ; {Set INK from the sprite attribute.
 $EEE4 RST $10       ;
 $EEE5 LD A,(IX+$09) ;
 $EEE8 RST $10       ; }
 $EEE9 LD HL,($5C36) ; #REGhl=*#SKOOLKID$5C36(CHARS).
 $EEEC PUSH HL       ; Stash #REGhl on the stack.
 $EEED PUSH IY       ; Stash #REGiy on the stack.
 $EEEF PUSH IX       ; Stash the sprite slot on the stack.
 $EEF1 LD E,(IX+$06) ; #REGe=the sprite frame ID.
 $EEF4 LD D,$00      ; #REGd=#N$00.
 $EEF6 SLA E         ; Shift #REGe left (with carry).
 $EEF8 RL D          ; Rotate #REGd left.
 $EEFA SLA E         ; Shift #REGe left (with carry).
 $EEFC RL D          ; Rotate #REGd left.
 $EEFE SLA E         ; Shift #REGe left (with carry).
 $EF00 RL D          ; Rotate #REGd left.
 $EF02 ADD HL,DE     ; Add that offset to the current character set.
 $EF03 LD B,(IX+$02) ; #REGb=the horizontal offset.
 $EF06 INC B         ; Increment #REGb by one.
 $EF07 LD C,$00      ; #REGc=#N$00.
 $EF09 LD ($F332),BC ; Write the pixel-shift count to *#R$F332.
 $EF0D LD E,(IX+$07) ; #REGe=the sprite width.
 $EF10 LD D,(IX+$08) ; #REGd=the sprite height.
 $EF13 LD A,D        ; #REGa=#REGd.
 $EF14 INC A         ; Increment #REGa by one.
 $EF15 SLA A         ; {Shift #REGa left three positions (with carry).
 $EF17 SLA A         ;
 $EF19 SLA A         ; }
 $EF1B LD C,A        ; #REGc=#REGa.
 $EF1C LD B,$00      ; #REGb=#N$00.
 $EF1E LD IY,$A0F4   ; #REGiy=#R$A0F4.
 $EF22 ADD IY,BC     ; #REGiy+=#REGbc.
 $EF24 LD C,E        ; #REGc=#REGe.
 $EF25 SLA C         ; Shift #REGc left (with carry).
 $EF27 SLA C         ; Shift #REGc left (with carry).
 $EF29 SLA C         ; Shift #REGc left (with carry).
 $EF2B LD B,$00      ; #REGb=#N$00.
 $EF2D LD ($F33C),BC ; Write #REGbc to *#R$F33C.
 $EF31 LD IX,$A0F4   ; #REGix=#R$A0F4.
*$EF35 PUSH HL       ; {Stash #REGhl, #REGde and #REGhl on the stack.
 $EF36 PUSH DE       ;
*$EF37 PUSH HL       ; }
 $EF38 LD B,$08      ; #REGb=#N$08.
*$EF3A PUSH BC       ; Stash #REGbc on the stack.
 $EF3B LD A,(HL)     ; #REGa=*#REGhl.
 $EF3C LD BC,($F332) ; #REGbc=*#R$F332.
*$EF40 SLA A         ; Shift #REGa left (with carry).
 $EF42 RL C          ; Rotate #REGc left.
 $EF44 SLA A         ; Shift #REGa left (with carry).
 $EF46 RL C          ; Rotate #REGc left.
 $EF48 DJNZ $EF40    ; Decrease counter by one and loop back to #R$EF40 until
                     ; counter is zero.
 $EF4A LD (IY+$00),A ; Write #REGa to *#REGiy+#N$00.
 $EF4D LD A,C        ; #REGa=#REGc.
 $EF4E OR (IX+$00)   ; Set the bits of #REGa with *#REGix+#N$00.
 $EF51 LD (IX+$00),A ; Write #REGa to *#REGix+#N$00.
 $EF54 INC HL        ; Increment #REGhl by one.
 $EF55 INC IX        ; Increment #REGix by one.
 $EF57 INC IY        ; Increment #REGiy by one.
 $EF59 POP BC        ; Restore #REGbc from the stack.
 $EF5A DJNZ $EF3A    ; Decrease counter by one and loop back to #R$EF3A until
                     ; counter is zero.
 $EF5C POP HL        ; Restore #REGhl from the stack.
 $EF5D LD BC,($F33C) ; {#REGhl+=*#R$F33C.
 $EF61 ADD HL,BC     ; }
 $EF62 DEC D         ; Decrease #REGd by one.
 $EF63 JR NZ,$EF37   ; Jump to #R$EF37 until #REGd is zero.
 $EF65 POP DE        ; Restore #REGde from the stack.
 $EF66 LD BC,$0008   ; #REGbc=#N($0008,$04,$04).
 $EF69 ADD IX,BC     ; #REGix+=#REGbc.
 $EF6B ADD IY,BC     ; #REGiy+=#REGbc.
 $EF6D POP HL        ; Restore #REGhl from the stack.
 $EF6E ADD HL,BC     ; #REGhl+=#REGbc.
 $EF6F DEC E         ; Decrease #REGe by one.
 $EF70 JR NZ,$EF35   ; Jump to #R$EF35 until #REGe is zero.
 $EF72 LD HL,$9FEC   ; #REGhl=#R$9FEC.
 $EF75 POP IX        ; Restore #REGix from the stack.
 $EF77 LD A,(IX+$03) ; #REGa=the vertical offset.
 $EF7A INC A         ; Increment #REGa by one.
 $EF7B SLA A         ; Shift #REGa left (with carry).
 $EF7D LD E,A        ; #REGe=#REGa.
 $EF7E LD D,$00      ; #REGd=#N$00.
 $EF80 ADD HL,DE     ; #REGhl+=#REGde.
 $EF81 LD ($5C36),HL ; Write #REGhl to *#SKOOLKID$5C36(CHARS).
 $EF84 LD D,(IX+$08) ; #REGd=the sprite height.
 $EF87 LD E,(IX+$07) ; #REGe=the sprite width.
 $EF8A LD A,(IX+$02) ; {Jump to #R$EF92 if the horizontal offset is #N$03.
 $EF8D CP $03        ;
 $EF8F JR Z,$EF92    ; }
 $EF91 INC E         ; Increment #REGe by one.
*$EF92 INC D         ; Increment #REGd by one.
 $EF93 LD A,D        ; #REGa=#REGd.
 $EF94 LD ($F33E),A  ; Write #REGa to *#R$F33E.
 $EF97 LD A,$03      ; {Jump to #R$EF9F if #N$03 is not equal to *#REGix+#N$03.
 $EF99 CP (IX+$03)   ;
 $EF9C JR NZ,$EF9F   ; }
 $EF9E DEC D         ; Decrease #REGd by one.
*$EF9F LD B,(IX+$01) ; #REGb=*#REGix+#N$01.
 $EFA2 LD C,(IX+$00) ; #REGc=*#REGix+#N$00.
 $EFA5 LD A,D        ; #REGa=#REGd.
 $EFA6 LD A,$20      ; #REGa=#N$20.
 $EFA8 POP IY        ; Restore #REGiy from the stack.
 $EFAA LD A,$20      ; #REGa=#N$20.
*$EFAC PUSH AF       ; {Stash #REGaf, #REGde and #REGbc on the stack.
 $EFAD PUSH DE       ;
 $EFAE PUSH BC       ; }
 $EFAF LD D,A        ; #REGd=#REGa.
 $EFB0 LD A,C        ; {Jump to #R$EFE9 if #REGc is higher than #N$22.
 $EFB1 CP $22        ;
 $EFB3 JR NC,$EFE9   ; }
*$EFB5 PUSH DE       ; Stash #REGde on the stack.
 $EFB6 CALL $0DD9    ; Call #SKOOLKID$0DD9(CL_SET).
 $EFB9 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $EFBA POP BC        ; }
 $EFBB PUSH BC       ; Stash #REGbc on the stack.
 $EFBC LD A,D        ; #REGa=#REGd.
*$EFBD CALL $E6DC    ; Call #R$E6DC.
 $EFC0 LD A,C        ; {Call #R$EFDC if #REGc is equal to #N$02.
 $EFC1 CP $02        ;
 $EFC3 CALL Z,$EFDC  ; }
 $EFC6 DEC C         ; Decrease #REGc by one.
 $EFC7 LD A,($F33E)  ; {#REGd+=*#R$F33E.
 $EFCA ADD A,D       ;
 $EFCB LD D,A        ; }
 $EFCC DEC E         ; Decrease #REGe by one.
 $EFCD JR NZ,$EFBD   ; Jump to #R$EFBD until #REGe is zero.
 $EFCF POP BC        ; {Restore #REGbc, #REGde and #REGaf from the stack.
 $EFD0 POP DE        ;
 $EFD1 POP AF        ; }
 $EFD2 DEC B         ; Decrease #REGb by one.
 $EFD3 INC A         ; Increment #REGa by one.
 $EFD4 DEC D         ; Decrease #REGd by one.
 $EFD5 JR NZ,$EFAC   ; Jump to #R$EFAC until #REGd is zero.
*$EFD7 POP HL        ; Restore #REGhl from the stack.
 $EFD8 LD ($5C36),HL ; Write #REGhl to *#SKOOLKID$5C36(CHARS).
 $EFDB RET           ; Return.
*$EFDC DEC E         ; Decrease #REGe by one.
 $EFDD PUSH AF       ; Stash #REGaf on the stack.
 $EFDE INC E         ; Increment #REGe by one.
 $EFDF POP AF        ; Restore #REGaf from the stack.
 $EFE0 RET Z         ; Return if #REGe is zero.
 $EFE1 DEC E         ; Decrease #REGe by one.
 $EFE2 LD A,($F33E)  ; {#REGd+=*#R$F33E.
 $EFE5 ADD A,D       ;
 $EFE6 LD D,A        ; }
 $EFE7 JR $EFDC      ; Jump to #R$EFDC.
*$EFE9 LD A,($F33E)  ; {#REGd+=*#R$F33E.
 $EFEC ADD A,D       ;
 $EFED LD D,A        ; }
 $EFEE DEC E         ; Decrease #REGe by one.
 $EFEF JP Z,$EFFB    ; Jump to #R$EFFB if #REGe is zero.
 $EFF2 DEC C         ; Decrease #REGc by one.
 $EFF3 LD A,C        ; {Jump to #R$EFE9 if #REGc is higher than #N$22.
 $EFF4 CP $22        ;
 $EFF6 JR NC,$EFE9   ; }
 $EFF8 JP $EFB5      ; Jump to #R$EFB5.
*$EFFB POP BC        ; {Restore #REGbc, #REGbc and #REGbc from the stack.
 $EFFC POP BC        ;
 $EFFD POP BC        ; }
 $EFFE JP $EFD7      ; Jump to #R$EFD7.

; Handler: Pirates
;
; Used by the routine at #R$DEA8.
;
; .
;
; See #POKE(noPirates,No Pirates).
@label=Handler_Pirates
c$F001 LD A,($F334)    ; {Return if *#R$F334 is a skipped frame.
 $F004 CP $00          ;
 $F006 RET Z           ; }
 $F007 LD HL,$8E28     ; {Write #R$8F28(#N$8E28) to *#SKOOLKID$5C36(CHARS).
 $F00A LD ($5C36),HL   ; }
 $F00D LD IX,($5BDE)   ; Point #REGix at *#R$5BDE.
@label=Handler_Pirates_Loop
*$F011 LD A,(IX+$00)   ; {Return if this pirate entry is the terminator
 $F014 CP $FF          ; (#N$FF).
 $F016 RET Z           ; }
 $F017 LD A,$10        ; {Set INK from the pirate attribute.
 $F019 RST $10         ;
 $F01A LD A,(IX+$09)   ;
 $F01D RST $10         ; }
; Advance the pirate walk frame.
 $F01E LD A,(IX+$06)   ; Fetch the current pirate sprite ID.
 $F021 ADD A,$06       ; Add one walk frame.
 $F023 LD (IX+$06),A   ; Write it back to the pirate sprite ID.
; Wrap the walk cycle at each facing's last frame.
 $F026 CP $4A          ; {Jump to #R$F02E if the right-facing frames have not
 $F028 JR NZ,$F02E     ; wrapped.}
 $F02A LD (IX+$06),$20 ; Reset to the first right-facing pirate frame.
@label=Handler_Pirates_CheckSpriteFrames
*$F02E CP $80          ; {Jump to #R$F036 if the left-facing frames have not
 $F030 JR NZ,$F036     ; wrapped.}
 $F032 LD (IX+$06),$50 ; Reset to the first left-facing pirate frame.
@label=Handler_Pirates_SkipSpriteFrames
*$F036 CALL $EEA6      ; Apply the pirate's movement deltas.
 $F039 LD A,C          ; {Jump to #R$F0EE if the pirate walked off the right.
 $F03A CP $22          ;
 $F03C JP Z,$F0EE      ; }
 $F03F CP $03          ; {Jump to #R$F0E3 if the pirate walked off the left.
 $F041 JP Z,$F0E3      ; }
 $F044 PUSH DE         ; {Stash the new position and offsets on the stack.
 $F045 PUSH BC         ; }
 $F046 LD A,(IX+$04)   ; {Jump to #R$F04F if the pirate is not moving right.
 $F049 CP $FF          ;
 $F04B JR NZ,$F04F     ; }
 $F04D DEC C           ; {Adjust the test column when moving right.
 $F04E DEC C           ; }
*$F04F CALL $F1AF      ; Look for a key or locked door in this column.
 $F052 POP BC          ; {Restore the new position and offsets from the stack.
 $F053 POP DE          ; }
 $F054 CP $FF          ; {Jump to #R$F0F9 if a key or locked door blocks this
 $F056 JP NZ,$F0F9     ; column.}
 $F059 PUSH BC         ; {Stash the new position and offsets on the stack.
 $F05A PUSH DE         ; }
 $F05B DEC B           ; {Move three rows up to the pirate's feet.
 $F05C DEC B           ;
 $F05D DEC B           ; }
 $F05E LD A,(IX+$04)   ; {Jump to #R$F067 if the pirate is not moving right.
 $F061 CP $FF          ;
 $F063 JR NZ,$F067     ; }
 $F065 DEC C           ; {Adjust the test column when moving right.
 $F066 DEC C           ; }
*$F067 CALL $E762      ; Convert that foot position into a room-buffer offset.
 $F06A LD HL,$A1C4     ; #REGhl=#R$A1C4.
 $F06D LD DE,($F330)   ; Add the offset from *#R$F330.
 $F071 ADD HL,DE       ; #REGhl+=#REGde.
 $F072 POP DE          ; {Restore the new position and offsets from the stack.
 $F073 POP BC          ; }
 $F074 LD A,(HL)       ; {Jump to #R$F0F9 if that buffer tile is empty space.
 $F075 CP $21          ;
 $F077 JP C,$F0F9      ; }
 $F07A LD (IX+$00),C   ; Write the new horizontal co-ordinate back to the
                       ; pirate.
 $F07D LD (IX+$01),B   ; Write the new vertical co-ordinate back to the pirate.
 $F080 LD (IX+$02),E   ; Write the new horizontal offset back to the pirate.
 $F083 LD (IX+$03),D   ; Write the new vertical offset back to the pirate.
 $F086 CALL $E9E2      ; Erase the pirate's previous sprite.
*$F089 CALL $EED7      ; Print the pirate.
 $F08C LD A,(IX+$00)   ; {Copy the horizontal co-ordinate to the previous-horizontal
 $F08F LD (IX+$0D),A   ; slot.}
 $F092 LD A,(IX+$01)   ; {Copy the vertical co-ordinate to the previous-vertical
 $F095 LD (IX+$0E),A   ; slot.}
 $F098 LD A,(IX+$02)   ; {Copy the horizontal offset to the previous-offset
 $F09B LD (IX+$0B),A   ; slot.}
 $F09E LD A,(IX+$03)   ; {Copy the vertical offset to the previous-vertical-offset
 $F0A1 LD (IX+$0F),A   ; slot.}
; Test whether the pirate overlaps the player.
 $F0A4 LD C,(IX+$00)   ; #REGc=the pirate horizontal co-ordinate.
 $F0A7 DEC C           ; Decrease #REGc by one.
 $F0A8 SLA C           ; {Convert it to a pixel column.
 $F0AA SLA C           ; }
 $F0AC LD A,(IX+$02)   ; Add the pirate's horizontal offset.
 $F0AF ADD A,C         ; #REGa+=#REGc.
 $F0B0 LD C,A          ; #REGc=the pirate's pixel column.
 $F0B1 LD A,($F233)    ; {#REGb=*#R$F233.
 $F0B4 LD B,A          ; }
 $F0B5 LD A,($F231)    ; #REGa=*#R$F231.
 $F0B8 DEC A           ; Decrease #REGa by one.
 $F0B9 SLA A           ; {Convert the player column to a pixel position.
 $F0BB SLA A           ; }
 $F0BD ADD A,B         ; Add the player's horizontal offset.
 $F0BE ADD A,$07       ; Add the player's pixel width.
 $F0C0 SUB C           ; Subtract the pirate's pixel column.
; See #POKE(immunePirates,Immune To Pirates).
 $F0C1 CP $10          ; {Jump to #R$F0DB if the player is outside the pirate's
 $F0C3 JR NC,$F0DB     ; horizontal span.}
 $F0C5 LD B,(IX+$01)   ; #REGb=the pirate vertical co-ordinate.
 $F0C8 LD A,($F232)    ; #REGa=*#R$F232.
 $F0CB ADD A,$02       ; Add the player's height.
 $F0CD SUB B           ; Subtract the pirate vertical co-ordinate.
 $F0CE CP $06          ; {Jump to #R$F0DB if the player is outside the pirate's
 $F0D0 JP NC,$F0DB     ; vertical span.}
 $F0D3 LD A,$02        ; {Queue the "caught by pirate" sound at #R$FFFE.
 $F0D5 LD ($FFFE),A    ; }
 $F0D8 JP $E3A4        ; Jump to #R$E3A4 to lose a life.
; Move onto the next pirate.
@label=Handler_Pirate_Next
*$F0DB LD DE,$0010     ; {Move #REGix on to the next sixteen-byte pirate entry.
 $F0DE ADD IX,DE       ; }
 $F0E0 JP $F011        ; Jump to #R$F011.
; Face and move left, then reprint.
@label=Handler_Pirate_TurnLeft
*$F0E3 LD (IX+$04),$01 ; Set horizontal movement to the left.
 $F0E7 LD (IX+$06),$50 ; Write the first left-facing pirate frame.
 $F0EB JP $F089        ; Jump to #R$F089.
; Face and move right, then reprint.
@label=Handler_Pirate_TurnRight
*$F0EE LD (IX+$04),$FF ; Set horizontal movement to the right.
 $F0F2 LD (IX+$06),$20 ; Write the first right-facing pirate frame.
 $F0F6 JP $F089        ; Jump to #R$F089.
; Turn the pirate around after a blocked step.
@label=Pirate_TurnController
*$F0F9 LD A,(IX+$04)   ; {Jump to #R$F0E3 if the pirate is moving right.
 $F0FC CP $FF          ;
 $F0FE JP Z,$F0E3      ; }
 $F101 JP $F0EE        ; Jump to #R$F0EE.

; Handler: Housekeeping
;
; Used by the routines at #R$F107 and #R$F1AF.
;
; .
;
; Clears the data reference from the stack before returning.
@label=Handler_Housekeeping
c$F104 POP IX        ; Restore the current data reference from the stack.
 $F106 RET           ; Return.

; Handler: Keys And Locked Doors
;
; Used by the routine at #R$EBD8.
; .
; Picks up the key at #REGbc, blanks it, and reprints any
; previously held key.
@label=Handler_KeysAndLockedDoors
c$F107 PUSH IX         ; Stash the player slot on the stack.
 $F109 LD IX,($5BDA)   ; Point #REGix at *#R$5BDA.
@label=Handler_KeysAndLockedDoors_Loop
*$F10D LD A,(IX+$00)   ; {Jump to #R$F104 if this key entry is the terminator
 $F110 CP $FF          ; (#N$FF).
 $F112 JR Z,$F104      ; }
 $F114 LD A,(IX+$05)   ; #REGa=the key state.
 $F117 AND %00000010   ; Keep only bit 1 (key still in the room).
 $F119 JR Z,$F127      ; Jump to #R$F127 if this key has already been taken.
 $F11B LD A,(IX+$02)   ; {Jump to #R$F127 if the player is not in this key's
 $F11E CP C            ; column.
 $F11F JR NZ,$F127     ; }
 $F121 LD A,(IX+$03)   ; {Jump to #R$F12E if the player is on this key's row.
 $F124 CP B            ;
 $F125 JR Z,$F12E      ; }
@label=Handler_KeysAndLockedDoors_Next
*$F127 LD DE,$0006     ; {Move #REGix on to the next six-byte key entry.
 $F12A ADD IX,DE       ; }
 $F12C JR $F10D        ; Jump to #R$F10D.
; Collect this key and blank its graphic.
*$F12E LD A,$06        ; {Queue the collected-key sound at #R$FFFE.
 $F130 LD ($FFFE),A    ; }
 $F133 LD (IX+$05),$01 ; Mark this key as taken.
 $F137 LD C,(IX+$02)   ; #REGc=the key's horizontal co-ordinate.
 $F13A LD B,(IX+$03)   ; #REGb=the key's vertical co-ordinate.
 $F13D LD E,$01        ; {Set the blank sprite width/ height (#N$01/ #N$02).
 $F13F LD D,$02        ; }
 $F141 LD A,$00        ; #REGa=#N$00.
 $F143 CALL $E72F      ; Blank the key in the game sprite buffer.
 $F146 LD HL,($5C36)   ; {Stash *#SKOOLKID$5C36(CHARS) on the stack.
 $F149 PUSH HL         ; }
 $F14A LD HL,$9F6C     ; {Write #R$A06C(#N$9F6C) to *#SKOOLKID$5C36(CHARS).
 $F14D LD ($5C36),HL   ; }
 $F150 LD A,$20        ; #REGa=a blank character.
 $F152 CALL $EA93      ; Print the blank over the key.
 $F155 POP HL          ; {Restore the original value of *#SKOOLKID$5C36(CHARS) from
 $F156 LD ($5C36),HL   ; the stack.}
 $F159 LD A,(IX+$04)   ; #REGa=this key's ID.
 $F15C POP IX          ; Restore the player slot from the stack.
 $F15E PUSH AF         ; Stash the new key ID on the stack.
 $F15F LD A,(IX+$10)   ; {Jump to #R$F1AA if *#R$F241 is empty.
 $F162 CP $00          ;
 $F164 JR Z,$F1AA      ; }
; Drop the previously held key back into the room.
 $F166 PUSH IX         ; Stash the player slot on the stack.
 $F168 CALL $F1E5      ; Find the table entry for the held key.
 $F16B LD HL,($5C36)   ; {Stash *#SKOOLKID$5C36(CHARS) on the stack.
 $F16E PUSH HL         ; }
 $F16F LD HL,$8378     ; {Write #R$8478(#N$8378) to *#SKOOLKID$5C36(CHARS).
 $F172 LD ($5C36),HL   ; }
 $F175 LD A,$10        ; {Set INK: *#R$5BCC.
 $F177 RST $10         ;
 $F178 LD A,($5BCC)    ;
 $F17B RST $10         ; }
 $F17C LD (IX+$05),$03 ; Mark that key as back in the room.
 $F180 LD C,(IX+$02)   ; #REGc=the dropped key's horizontal co-ordinate.
 $F183 LD B,(IX+$03)   ; #REGb=the dropped key's vertical co-ordinate.
 $F186 PUSH BC         ; Stash the key position on the stack.
 $F187 CALL $E762      ; Convert it into a room-buffer offset.
 $F18A CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $F18D LD A,(IX+$04)   ; #REGa=the dropped key's ID.
 $F190 ADD A,$41       ; #REGa+=#N$41 (key label; see #R$8588).
 $F192 CALL $E804      ; Call #R$E804.
 $F195 RST $10         ; Print the key letter using RST
                       ; #SKOOLKID$0010(PRINT_A_1).
 $F196 POP BC          ; Restore the key position from the stack.
 $F197 DEC B           ; Move one row down for the key stem.
 $F198 CALL $E762      ; Convert it into a room-buffer offset.
 $F19B CALL $0DD9      ; Call #SKOOLKID$0DD9(CL_SET).
 $F19E LD A,$4B        ; #REGa=#R$85D0 (#N$4B).
 $F1A0 CALL $E804      ; Call #R$E804.
 $F1A3 RST $10         ; Print the key stem using RST
                       ; #SKOOLKID$0010(PRINT_A_1).
 $F1A4 POP HL          ; {Restore the original value of *#SKOOLKID$5C36(CHARS) from
 $F1A5 LD ($5C36),HL   ; the stack.}
 $F1A8 POP IX          ; Restore the player slot from the stack.
*$F1AA POP AF          ; Restore the new key ID from the stack.
 $F1AB LD (IX+$10),A   ; Write it to *#R$F241.
 $F1AE RET             ; Return.

; Find Key At Position
;
; Used by the routines at #R$EBD8 and #R$F001.
; .
; Walks #R$5BDA looking for a key or locked door at #REGbc.
;
;   B Vertical position
;   C Horizontal position
; O:A Key ID, or #N$FF if the slot is empty
@label=FindKeyAtPosition
c$F1AF PUSH IX       ; Stash #REGix on the stack.
 $F1B1 LD IX,($5BDA) ; Point #REGix at *#R$5BDA.
 $F1B5 LD DE,$0006   ; #REGde=#N($0006,$04,$04) (key entry length).
*$F1B8 LD A,$FF      ; {Jump to #R$F104 if this key entry is the terminator
 $F1BA CP (IX+$00)   ; (#N$FF).
 $F1BD JP Z,$F104    ; }
 $F1C0 LD A,C        ; {Jump to #R$F1E1 if this is not the tested column.
 $F1C1 CP (IX+$00)   ;
 $F1C4 JR NZ,$F1E1   ; }
 $F1C6 LD A,(IX+$01) ; #REGa=the locked-door vertical.
 $F1C9 DEC A         ; {Move two rows up to the door's foot.
 $F1CA DEC A         ; }
 $F1CB CP B          ; {Jump to #R$F1E1 if this is not the tested row.
 $F1CC JR NZ,$F1E1   ; }
 $F1CE LD A,(IX+$05) ; {Test whether this key is still in the room.
 $F1D1 CP $00        ; }
 $F1D3 LD A,$FF      ; #REGa=#N$FF (no key here).
 $F1D5 JP Z,$F104    ; Jump to #R$F104 if this key has already been taken.
 $F1D8 LD A,(IX+$04) ; #REGa=this key's ID.
 $F1DB PUSH IX       ; {#REGhl=#REGix (using the stack).
 $F1DD POP HL        ; }
 $F1DE POP IX        ; Restore #REGix from the stack.
 $F1E0 RET           ; Return.
*$F1E1 ADD IX,DE     ; Move #REGix on to the next key entry.
 $F1E3 JR $F1B8      ; Jump to #R$F1B8.

; Find Matching Key
;
; Used by the routine at #R$F107.
; .
; Walks #R$5BDA looking for an entry whose key ID matches #REGa.
;
;   A Key ID to match
; O:IX Matching key table entry
@label=FindMatchingKey
c$F1E5 LD DE,$0006   ; #REGde=#N($0006,$04,$04) (key entry length).
 $F1E8 LD C,A        ; #REGc=the key ID to match.
 $F1E9 LD IX,($5BDA) ; Point #REGix at *#R$5BDA.
*$F1ED LD A,(IX+$00) ; {Return if this key entry is the terminator (#N$FF).
 $F1F0 CP $FF        ;
 $F1F2 RET Z         ; }
 $F1F3 LD A,C        ; {Return if this entry's key ID matches.
 $F1F4 CP (IX+$04)   ;
 $F1F7 RET Z         ; }
 $F1F8 ADD IX,DE     ; Move #REGix on to the next key entry.
 $F1FA JR $F1ED      ; Jump to #R$F1ED.

; Handler: Port Hole
;
; Used by the routine at #R$DEA8.
;
; .
;
; Set the UDG graphics pointer.
@label=Handler_PortHole
c$F1FC LD HL,$914C   ; {Write #R$924C(#N$914C) to *#SKOOLKID$5C36(CHARS).
 $F1FF LD ($5C36),HL ; }
; Set the attributes.
 $F202 LD A,$10      ; {Set INK: CYAN (#N$05).
 $F204 RST $10       ;
 $F205 LD A,$05      ;
 $F207 RST $10       ; }
; Only animate the port holes every 4th frame.
 $F208 LD A,($F259)  ; #REGa=*#R$F259.
 $F20B INC A         ; Increment #REGa by one.
 $F20C AND %00000011 ; Keep *#R$F259 in the range #N$00-#N$03.
 $F20E LD ($F259),A  ; Write #REGa to *#R$F259.
 $F211 RET NZ        ; Return if *#R$F259 is a skipped frame.
; The data is stored as: #TABLE(default,centre,centre)
; { =h Byte Offset | =h Data }
; { +#N$00 | Horizontal Position }
; { +#N$01 | Vertical Position }
; { +#N$02 | Frame/ Sprite ID }
; TABLE#
; .
; Walk the port-hole table at *#R$5BDC.
 $F212 LD HL,($5BDC) ; #REGhl=*#R$5BDC.
; Keep looping until the terminator.
@label=Handler_PortHole_Loop
*$F215 LD C,(HL)     ; {Fetch this port hole's column and row.
 $F216 INC HL        ;
 $F217 LD B,(HL)     ; }
 $F218 INC HL        ; Advance to the frame ID.
; Stop at the table terminator.
 $F219 LD A,$FF      ; {Return if this port-hole entry is the terminator
 $F21B CP C          ; (#N$FF).
 $F21C RET Z         ; }
; Advance the four-tile port-hole animation.
 $F21D LD A,(HL)     ; Fetch the current frame ID.
 $F21E ADD A,$04     ; Add one port-hole frame (#N$04 tiles).
 $F220 CP $40        ; {Jump to #R$F226 if the frames have not wrapped.
 $F222 JR NZ,$F226   ; }
; Reset to the first port-hole frame.
 $F224 LD A,$20      ; #REGa=the first port-hole frame.
; Store the frame and print the port hole.
@label=PrintPortHole
*$F226 LD (HL),A     ; Write the frame ID back to the table.
 $F227 INC HL        ; Advance to the next port-hole entry.
 $F228 LD D,$02      ; {Set the port-hole width/ height to #N$02/ #N$02.
 $F22A LD E,$02      ; }
 $F22C CALL $EA93    ; Print the port hole.
; Keeping looping around, this only finishes when a terminator is received.
 $F22F JR $F215      ; Jump to #R$F215.

; Table: Player Attributes
@label=TablePlayerAttributes
g$F231 DEFB $00      ; Horizontal co-ordinate (#N$21-#N$04).
 $F232 DEFB $00      ; Vertical co-ordinate (#N$15-#N$06).
 $F233 DEFB $00      ; Horizontal position in character block (#N$00-#N$03).
 $F234 DEFB $00      ; Vertical position in character block (#N$00-#N$03).
 $F235 DEFB $00      ; Horizontal movement indicator:
                     ; #TABLE(default,centre,centre)
                     ; { =h Byte | =h Meaning }
                     ; { #N$00 | Stationary }
                     ; { #N$01 | Moving Left }
                     ; { #N$FF | Moving Right }
                     ; TABLE#
 $F236 DEFB $00      ; Vertical movement indicator:
                     ; #TABLE(default,centre,centre)
                     ; { =h Byte | =h Meaning }
                     ; { #N$00 | Stationary }
                     ; { #N$01 | Moving Up }
                     ; { #N$FF | Moving Down }
                     ; TABLE#
@label=PlayerSpriteID
 $F237 DEFB $00      ; Sprite frame ID:
                     ; #TABLE(default,centre,centre)
                     ; { =h Byte | =h Meaning }
                     ; { #R$8A78(#N$20) | Facing Right Frame 1 }
                     ; { #R$8AA8(#N$26) | Facing Right Frame 2 }
                     ; { #R$8AD8(#N$2C) | Facing Right Frame 3 }
                     ; { #R$8B08(#N$32) | Facing Right Frame 4 }
                     ; { #R$8B38(#N$38) | Facing Right Frame 5 }
                     ; { #R$8B68(#N$3E) | Facing Right Frame 6 }
                     ; { #R$8B98(#N$44) | Facing Right Frame 7 }
                     ; { #R$8BC8(#N$4A) | Facing Right Frame 8 }
                     ; { #R$8BF8(#N$50) | Facing Left Frame 1 }
                     ; { #R$8C28(#N$56) | Facing Left Frame 2 }
                     ; { #R$8C58(#N$5C) | Facing Left Frame 3 }
                     ; { #R$8C88(#N$62) | Facing Left Frame 4 }
                     ; { #R$8CB8(#N$68) | Facing Left Frame 5 }
                     ; { #R$8CE8(#N$6E) | Facing Left Frame 6 }
                     ; { #R$8D18(#N$74) | Facing Left Frame 7 }
                     ; { #R$8D48(#N$7A) | Facing Left Frame 8 }
                     ; TABLE#
 $F238 DEFB $00      ; Sprite width: #N$02.
 $F239 DEFB $00      ; Sprite height: #N$03.
 $F23A DEFB $00      ; Sprite attribute: CYAN (#N$05).
 $F23B DEFB $00      ; Working byte (initialised with the player table)
 $F23C DEFB $00      ; Previous horizontal offset
 $F23D DEFB $00      ; Working byte (initialised with the player table)
 $F23E DEFB $00      ; Previous horizontal co-ordinate
 $F23F DEFB $00      ; Previous vertical co-ordinate
 $F240 DEFB $00      ; Previous vertical offset
@label=PlayerKeyHeld
 $F241 DEFB $00      ; Key (in possession).
@label=PlayerActionState
 $F242 DEFB $00      ; Action state:
                     ; #TABLE(default,centre,centre)
                     ; { =h Byte | =h Meaning }
                     ; { #N$01 | Emerging from a door }
                     ; { #N$02 | Blocked / no walk }
                     ; { #N$03 | On a ladder }
                     ; { #N$04 | Facing left }
                     ; { #N$13 | Facing right }
                     ; TABLE#
@label=PlayerLadderBoundUpper
 $F243 DEFB $00      ; Upper ladder bound.
@label=PlayerLadderBoundLower
 $F244 DEFB $00      ; Lower ladder bound.

; Table: Default Player Attributes
;
; See #R$F231.
@label=TableDefaultPlayerAttributes
g$F245 DEFB $10      ; Starting horizontal co-ordinate: #N(#PEEK(#PC)).
 $F246 DEFB $16      ; Starting vertical co-ordinate: #N(#PEEK(#PC)).
 $F247 DEFB $03      ; Starting horizontal offset: #N(#PEEK(#PC)).
 $F248 DEFB $03      ; Starting vertical offset: #N(#PEEK(#PC)).
 $F249 DEFB $00      ; Horizontal movement: #MAP(#PEEK(#PC))(?,0:stationary).
 $F24A DEFB $00      ; Vertical movement: #MAP(#PEEK(#PC))(?,0:stationary).
 $F24B DEFB $20      ; Starting sprite frame ID: #N(#PEEK(#PC)).
 $F24C DEFB $02      ; Sprite width: #N(#PEEK(#PC)).
 $F24D DEFB $03      ; Sprite height: #N(#PEEK(#PC)).
 $F24E DEFB $05      ; Sprite attribute: CYAN #N(#PEEK(#PC)).
 $F24F DEFB $01      ; Working byte: #N(#PEEK(#PC)).
 $F250 DEFB $00      ; Previous horizontal offset: #N(#PEEK(#PC)).
 $F251 DEFB $00      ; Working byte: #N(#PEEK(#PC)).
 $F252 DEFB $10      ; Previous horizontal co-ordinate: #N(#PEEK(#PC)).
 $F253 DEFB $16      ; Previous vertical co-ordinate: #N(#PEEK(#PC)).
 $F254 DEFB $03      ; Previous vertical offset: #N(#PEEK(#PC)).
 $F255 DEFB $00      ; Key (in possession): #MAP(#PEEK(#PC))(?,0:none).
 $F256 DEFB $00      ; Starting action state: #N(#PEEK(#PC)).
 $F257 DEFB $00      ; Ladder bound: #N(#PEEK(#PC)).
 $F258 DEFB $00      ; Ladder bound: #N(#PEEK(#PC)).

; Port Hole Timer Frame Skip
;
; This value is incremented every frame, and every 4th frame will animate the port holes (if there are any).
; See #R$F1FC.
@label=TimerPortHole_FrameSkip
g$F259 DEFB $FF

; Unused
u$F25A DEFB $00

; Graphics: Extra
@label=Graphics_Spark
b$F25B DEFB $10,$1B,$3E,$1C,$F8,$30,$12,$10 ; #UDGTABLE {
                                            ; #UDG(#PC,attr=$0F)(spark) }
                                            ; UDGTABLE#
@label=Graphics_Life
 $F263 DEFB $38,$38,$10,$FE,$38,$38,$28,$6C ; #UDGTABLE {
                                            ; #UDG(#PC,attr=$06)(life) }
                                            ; UDGTABLE#
@label=Graphics_Key
 $F26B DEFB $00,$70,$88,$8F,$8F,$88,$70,$00 ; {#UDGTABLE {
 $F273 DEFB $00,$00,$00,$FE,$FE,$3E,$2A,$00 ; #UDGS$02,$01,$04(key)(#UDG(#PC+$08*$x,attr=$06)(*key)key)
                                            ; } UDGTABLE#}

; Graphics: Lifts
@label=Graphics_Lifts
b$F27B DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; #UDGTABLE { #UDG(#PC) } UDGTABLE#
 $F283 DEFB $3F,$3F,$3F,$3F,$00,$00,$00,$00 ; #UDGTABLE { #UDG(#PC) } UDGTABLE#
 $F28B DEFB $FF,$FF,$FF,$FF,$00,$00,$00,$00 ; #UDGTABLE { #UDG(#PC) } UDGTABLE#
 $F293 DEFB $FC,$FC,$FC,$FC,$00,$00,$00,$00 ; #UDGTABLE { #UDG(#PC) } UDGTABLE#
 $F29B DEFB $00,$00,$FF,$FF,$FF,$FF,$00,$00 ; #UDGTABLE { #UDG(#PC) } UDGTABLE#
