; Goldfish Game: Sprite Row Stride
;
; Used by the routine at #R$D647.
; .
; Byte width of the source sprite, used when #R$D647 advances to the
; next pixel row.
@label=GoldfishGame_SpriteRowStride
g$DB36 DEFW $0000

; Goldfish Game: Sprite Shift Work
;
; Used by the routine at #R$D647.
; .
; First holds the bit-rotate count while shifting, then the tile step
; when printing.
@label=GoldfishGame_SpriteShiftWork
g$DB38 DEFB $00,$00,$00

