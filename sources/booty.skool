; Sound Handler: Touched Animal
;
; Used by the routine at #R$F863.
@label=SoundHandler_TouchedAnimal
c$F7A4 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $F7A5 PUSH DE       ; }
 $F7A6 LD B,$0A      ; #REGb=#N$0A (repeat the beep ten times).
*$F7A8 PUSH BC       ; Stash the repeat count on the stack.
 $F7A9 LD BC,$0064   ; #REGbc=#N($0064,$04,$04) (delay).
 $F7AC LD DE,$0032   ; #REGde=#N($0032,$04,$04) (duration).
; #HTML(#AUDIO0(touched-animal.wav)(#INCLUDE(TouchedAnimal)))
 $F7AF CALL $F66C    ; Play wave #2 for one animal-hit beep.
 $F7B2 POP BC        ; Restore #REGbc from the stack.
 $F7B3 DJNZ $F7A8    ; Decrease counter by one and loop back to #R$F7A8 until
                     ; counter is zero.
 $F7B5 POP DE        ; {Restore #REGde, #REGbc and #REGaf from the stack.
 $F7B6 POP BC        ;
 $F7B7 POP AF        ; }
; The sound has now been played, so turn off the flag.
 $F7B8 LD A,$00      ; {Write #N$00 to *#R$FFFE.
 $F7BA LD ($FFFE),A  ; }
 $F7BD POP AF        ; {Restore #REGaf and #REGiy from the stack.
 $F7BE POP IY        ; }
 $F7C0 EI            ; Enable interrupts.
 $F7C1 RET           ; Return.

; Sound Handler: Fuse Quiet
;
; Used by the routine at #R$F7D8.
; .
; Plays a short tone on the quiet frames of the bomb fuse, when bits
; 0-2 of *#R$FE88 are zero.
@label=SoundHandler_FuseQuiet
c$F7C2 LD BC,$0005   ; #REGbc=#N($0005,$04,$04) (delay).
 $F7C5 LD DE,$0032   ; #REGde=#N($0032,$04,$04) (duration).
; #HTML(#AUDIO0(fuse-quiet.wav)(#INCLUDE(FuseQuiet)))
 $F7C8 CALL $F648    ; Play wave #1 for a quiet fuse tick.
 $F7CB POP DE        ; {Restore #REGde, #REGbc, #REGaf and #REGaf from the
 $F7CC POP BC        ; stack.
 $F7CD POP AF        ;
 $F7CE POP AF        ; }
 $F7CF CALL $0038    ; Call #SKOOLKID$0038(MASK_INT).
 $F7D2 POP IY        ; Restore #REGiy from the stack.
 $F7D4 RET           ; Return.
 $F7D5 POP DE        ; {Restore #REGde and #REGbc from the stack.
 $F7D6 POP BC        ; }
 $F7D7 RET           ; Return.

; Sound Handler: Bomb Fuse
;
; Used by the routine at #R$F855.
@label=SoundHandler_BombFuse
c$F7D8 PUSH BC       ; {Stash #REGbc and #REGde on the stack.
 $F7D9 PUSH DE       ; }
 $F7DA LD A,($FE88)  ; #REGa=*#R$FE88.
 $F7DD AND %00000111 ; Keep only bits 0-2.
 $F7DF JP Z,$F7C2    ; Jump to #R$F7C2 on the quiet fuse frames.
 $F7E2 PUSH HL       ; Stash #REGhl on the stack.
 $F7E3 LD DE,$000A   ; #REGde=#N($000A,$04,$04) (duration).
 $F7E6 LD B,$1F      ; #REGb=#N$1F (noise pitch).
; #HTML(#AUDIO0(bomb-fuse.wav)(#INCLUDE(BombFuse)))
 $F7E8 CALL $F618    ; Play white noise for the burning fuse.
 $F7EB POP HL        ; {Restore #REGhl, #REGde, #REGbc, #REGaf and #REGaf from
 $F7EC POP DE        ; the stack.
 $F7ED POP BC        ;
 $F7EE POP AF        ;
 $F7EF POP AF        ; }
 $F7F0 CALL $0038    ; Call #SKOOLKID$0038(MASK_INT).
 $F7F3 POP IY        ; Restore #REGiy from the stack.
 $F7F5 RET           ; Return.

